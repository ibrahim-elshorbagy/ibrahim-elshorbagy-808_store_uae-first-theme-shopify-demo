{% doc %}
  @prompt
    Create a complete NEW product page section for a premium men's luxury footwear brand. Everything must use real Shopify Liquid data — no hardcoded or placeholder content.
    
    LAYOUT:
    - Two column desktop layout: left column 55% for image gallery, right column 45% for product info
    - Single column on mobile, images on top
    - Cream/ivory background (#F5F2EE), charcoal text (#2C2C2C), gold accents (#C9A84C)
    - Max width 1400px centered, 60px side padding desktop, 20px mobile
    
    LEFT COLUMN - IMAGE GALLERY:
    - Main image using product.featured_image, aspect ratio 4:5, object-fit cover
    - Thumbnail strip below showing all product.images, each 72x90px, border-radius 4px
    - Clicking thumbnail swaps main image using JavaScript
    - Sticky on desktop as user scrolls
    
    RIGHT COLUMN - PRODUCT INFO:
    - Vendor: {{ product.vendor }} in small gold uppercase text
    - Title: {{ product.title }} large serif font 32px
    - Price: {{ product.selected_or_first_available_variant.price | money }}, show compare_at_price struck through if on sale
    - Variant picker: loop through product.variants, show as pill buttons, clicking updates hidden form input
    - Quantity stepper: minus/plus buttons with number input, minimum 1
    - ADD TO CART: real working form with action="/cart/add" method="post", hidden input name="id" with variant id, quantity input, submit button with name="add"
    - Accordions for: product.description, Shipping and Returns, Size and Fit — smooth open/close animation
    - Trust badges row: Free Shipping, Easy Returns, Authenticity Guaranteed
    
    All JavaScript must be inline and functional. All data must come from Shopify Liquid objects.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign current_variant = product.selected_or_first_available_variant %}

{% style %}
  .ai-luxury-product-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px;
    background: #F5F2EE;
    color: #2C2C2C;
  }
  .ai-luxury-product__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 56px;
  }
  .ai-luxury-product__gallery-{{ ai_gen_id }} {
    position: sticky;
    top: 24px;
    align-self: start;
  }
  .ai-luxury-product__main-image-{{ ai_gen_id }} {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: transparent;
    border-radius: 4px;
  }
  .ai-luxury-product__main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ai-luxury-product__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }
  .ai-luxury-product__placeholder-{{ ai_gen_id }} svg { width: 100%; height: 100%; }
  .ai-luxury-product__thumbs-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-top: 14px;
  }
  .ai-luxury-product__thumb-{{ ai_gen_id }} {
    flex: 0 0 72px;
    width: 72px;
    height: 90px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 4px;
    overflow: hidden;
    background: transparent;
    cursor: pointer;
  }
  .ai-luxury-product__thumb-{{ ai_gen_id }}[aria-current="true"] { border-color: #C9A84C; }
  .ai-luxury-product__thumb-{{ ai_gen_id }} img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ai-luxury-product__info-{{ ai_gen_id }} { padding: 8px 0; }
  .ai-luxury-product__vendor-{{ ai_gen_id }} { margin: 0 0 14px; color: #8A6F25; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
  .ai-luxury-product__title-{{ ai_gen_id }} { margin: 0 0 20px; color: #2C2C2C; font-family: Georgia, 'Times New Roman', serif; font-size: 32px; line-height: 1.15; font-weight: 400; }
  .ai-luxury-product__price-{{ ai_gen_id }} { display: flex; gap: 12px; align-items: center; margin-bottom: 30px; font-size: 18px; }
  .ai-luxury-product__compare-{{ ai_gen_id }} { color: #6B6863; text-decoration: line-through; font-size: 14px; }
  .ai-luxury-product__label-{{ ai_gen_id }} { display: block; margin-bottom: 10px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .ai-luxury-product__variants-{{ ai_gen_id }} { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .ai-luxury-product__variant-{{ ai_gen_id }} { padding: 11px 16px; border: 1px solid #AAA39A; border-radius: 14px; background: transparent; color: #2C2C2C; cursor: pointer; }
  .ai-luxury-product__variant-{{ ai_gen_id }}[aria-pressed="true"] { border-color: #2C2C2C; background: #2C2C2C; color: #F5F2EE; }
  .ai-luxury-product__variant-{{ ai_gen_id }}:disabled { opacity: .45; cursor: not-allowed; }
  .ai-luxury-product__buy-row-{{ ai_gen_id }} { display: flex; gap: 10px; margin-bottom: 30px; }
  .ai-luxury-product__quantity-{{ ai_gen_id }} { display: flex; align-items: center; border: 1px solid #AAA39A; border-radius: 14px; }
  .ai-luxury-product__quantity-{{ ai_gen_id }} button { width: 38px; height: 48px; border: 0; background: transparent; color: #2C2C2C; cursor: pointer; font-size: 18px; }
  .ai-luxury-product__quantity-{{ ai_gen_id }} input { width: 34px; border: 0; background: transparent; color: #2C2C2C; text-align: center; }
  .ai-luxury-product__submit-{{ ai_gen_id }} { flex: 1; border: 0; border-radius: 14px; background: #2C2C2C; color: #F5F2EE; cursor: pointer; letter-spacing: .08em; text-transform: uppercase; }
  .ai-luxury-product__accordion-{{ ai_gen_id }} { border-top: 1px solid #C9C2B8; }
  .ai-luxury-product__accordion-{{ ai_gen_id }}:last-child { border-bottom: 1px solid #C9C2B8; }
  .ai-luxury-product__accordion-{{ ai_gen_id }} summary { padding: 18px 0; cursor: pointer; list-style: none; font-size: 14px; }
  .ai-luxury-product__accordion-{{ ai_gen_id }} summary::-webkit-details-marker { display: none; }
  .ai-luxury-product__accordion-{{ ai_gen_id }} summary::after { content: '+'; float: right; color: #8A6F25; font-size: 20px; }
  .ai-luxury-product__accordion-{{ ai_gen_id }}[open] summary::after { content: '−'; }
  .ai-luxury-product__accordion-content-{{ ai_gen_id }} { padding: 0 0 18px; color: #514D48; font-size: 14px; line-height: 1.7; }
  .ai-luxury-product__badges-{{ ai_gen_id }} { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 28px; color: #514D48; font-size: 11px; text-align: center; }
  .ai-luxury-product__badge-{{ ai_gen_id }} { padding-top: 14px; border-top: 1px solid #C9A84C; }
  @media screen and (max-width: 749px) {
    .ai-luxury-product-{{ ai_gen_id }} { padding: 20px; }
    .ai-luxury-product__inner-{{ ai_gen_id }} { display: block; }
    .ai-luxury-product__gallery-{{ ai_gen_id }} { position: static; margin-bottom: 32px; }
    .ai-luxury-product__title-{{ ai_gen_id }} { font-size: 28px; }
  }
{% endstyle %}

<luxury-product-{{ ai_gen_id }} class="ai-luxury-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-product__inner-{{ ai_gen_id }}">
    <div class="ai-luxury-product__gallery-{{ ai_gen_id }}">
      <div class="ai-luxury-product__main-image-{{ ai_gen_id }}">
        {% if product.featured_image %}
          <img data-main-image src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
        {% else %}
          <div class="ai-luxury-product__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
      {% if product.images.size > 0 %}
        <div class="ai-luxury-product__thumbs-{{ ai_gen_id }}" role="list">
          {% for image in product.images %}
            <button class="ai-luxury-product__thumb-{{ ai_gen_id }}" type="button" data-image-url="{{ image | image_url: width: 1400 }}" data-image-alt="{{ image.alt | default: product.title | escape }}" aria-current="{% if image == product.featured_image %}true{% else %}false{% endif %}" aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | default: product.title | escape }}" width="72" height="90" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="ai-luxury-product__info-{{ ai_gen_id }}">
      <p class="ai-luxury-product__vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
      <h1 class="ai-luxury-product__title-{{ ai_gen_id }}">{{ product.title }}</h1>
      <div class="ai-luxury-product__price-{{ ai_gen_id }}">
        <span data-price>{{ current_variant.price | money }}</span>
        <span class="ai-luxury-product__compare-{{ ai_gen_id }}" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</span>
      </div>

      <form action="/cart/add" method="post" data-product-form>
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <label class="ai-luxury-product__label-{{ ai_gen_id }}">Select size</label>
        <div class="ai-luxury-product__variants-{{ ai_gen_id }}" role="group" aria-label="Product variants">
          {% for variant in product.variants %}
            <button type="button" class="ai-luxury-product__variant-{{ ai_gen_id }}" data-variant-id="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare-price="{{ variant.compare_at_price | money | escape }}" data-available="{{ variant.available }}" aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>
          {% endfor %}
        </div>
        <div class="ai-luxury-product__buy-row-{{ ai_gen_id }}">
          <div class="ai-luxury-product__quantity-{{ ai_gen_id }}">
            <button type="button" data-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantity" data-quantity>
            <button type="button" data-plus aria-label="Increase quantity">+</button>
          </div>
          <button class="ai-luxury-product__submit-{{ ai_gen_id }}" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
        </div>
      </form>

      <details class="ai-luxury-product__accordion-{{ ai_gen_id }}" open>
        <summary>Product details</summary>
        <div class="ai-luxury-product__accordion-content-{{ ai_gen_id }}">{{ product.description }}</div>
      </details>
      <details class="ai-luxury-product__accordion-{{ ai_gen_id }}">
        <summary>Shipping and returns</summary>
        <div class="ai-luxury-product__accordion-content-{{ ai_gen_id }}">{{ shop.shipping_policy.body }}{{ shop.refund_policy.body }}</div>
      </details>
      <details class="ai-luxury-product__accordion-{{ ai_gen_id }}">
        <summary>Size and fit</summary>
        <div class="ai-luxury-product__accordion-content-{{ ai_gen_id }}">{{ product.metafields.custom.size_and_fit.value }}</div>
      </details>
      <div class="ai-luxury-product__badges-{{ ai_gen_id }}" aria-label="Product assurances">
        <div class="ai-luxury-product__badge-{{ ai_gen_id }}">Free shipping</div>
        <div class="ai-luxury-product__badge-{{ ai_gen_id }}">Easy returns</div>
        <div class="ai-luxury-product__badge-{{ ai_gen_id }}">Authenticity guaranteed</div>
      </div>
    </div>
  </div>
</luxury-product-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryProduct{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.mainImage = this.querySelector('[data-main-image]');
        this.variantInput = this.querySelector('[data-variant-id]');
        this.price = this.querySelector('[data-price]');
        this.compare = this.querySelector('[data-compare-price]');
        this.submit = this.querySelector('[name="add"]');
        this.quantity = this.querySelector('[data-quantity]');
        this.querySelectorAll('[data-image-url]').forEach((button) => button.addEventListener('click', () => {
          if (this.mainImage) {
            this.mainImage.src = button.dataset.imageUrl;
            this.mainImage.alt = button.dataset.imageAlt;
          }
          this.querySelectorAll('[data-image-url]').forEach((item) => item.setAttribute('aria-current', 'false'));
          button.setAttribute('aria-current', 'true');
        }));
        this.querySelectorAll('[data-variant-id]').forEach((button) => {
          if (!button.dataset.price) return;
          button.addEventListener('click', () => {
            this.variantInput.value = button.dataset.variantId;
            this.price.textContent = button.dataset.price;
            if (button.dataset.comparePrice && button.dataset.comparePrice !== button.dataset.price) {
              this.compare.textContent = button.dataset.comparePrice;
              this.compare.hidden = false;
            } else { this.compare.hidden = true; }
            this.querySelectorAll('[data-variant-id]').forEach((item) => item.setAttribute('aria-pressed', 'false'));
            button.setAttribute('aria-pressed', 'true');
            this.submit.disabled = button.dataset.available !== 'true';
            this.submit.textContent = button.dataset.available === 'true' ? 'Add to cart' : 'Sold out';
          });
        });
        this.querySelector('[data-minus]').addEventListener('click', () => { this.quantity.value = Math.max(1, Number(this.quantity.value) - 1); });
        this.querySelector('[data-plus]').addEventListener('click', () => { this.quantity.value = Number(this.quantity.value) + 1; });
      }
    }
    if (!customElements.get('luxury-product-{{ ai_gen_id }}')) customElements.define('luxury-product-{{ ai_gen_id }}', LuxuryProduct{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Luxury product details",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Luxury product details"
    }
  ],
  "tag": null,
  "class": "luxury-product-block"
}
{% endschema %}