{% doc %}
  @prompt
    Create a complete NEW product page section for a premium men's luxury footwear brand. Everything must use real Shopify Liquid data — no hardcoded or placeholder content.
    
    LAYOUT:
    - Two column desktop layout: left column 55% for image gallery, right column 45% for product info
    - Single column on mobile, images on top
    - Cream/ivory background (#F5F2EE), charcoal text (#2C2C2C), gold accents (#C9A84C)
    - Max width 1400px centered, 60px side padding desktop, 20px mobile
    
    LEFT COLUMN - IMAGE GALLERY:
    - Main image using product.featured_image, aspect ratio 4:5, object-fit cover
    - Thumbnail strip below showing all product.images, each 72x90px, border-radius 4px
    - Clicking thumbnail swaps main image using JavaScript
    - Sticky on desktop as user scrolls
    
    RIGHT COLUMN - PRODUCT INFO:
    - Vendor: {{ product.vendor }} in small gold uppercase text
    - Title: {{ product.title }} large serif font 32px
    - Price: {{ product.selected_or_first_available_variant.price | money }}, show compare_at_price struck through if on sale
    - Variant picker: loop through product.variants, show as pill buttons, clicking updates hidden form input
    - Quantity stepper: minus/plus buttons with number input, minimum 1
    - ADD TO CART: real working form with action="/cart/add" method="post", hidden input name="id" with variant id, quantity input, submit button with name="add"
    - Accordions for: product.description, Shipping and Returns, Size and Fit — smooth open/close animation
    - Trust badges row: Free Shipping, Easy Returns, Authenticity Guaranteed
    
    All JavaScript must be inline and functional. All data must come from Shopify Liquid objects., delete section of  Shipping and returns and Size and fill And make the deesciotnio accordion, see the section of features make it more better look
    , on the section you have here see the section of features make it more better look
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign current_variant = product.selected_or_first_available_variant %}
{% style %}.ai-luxury-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;padding:60px;background:#F5F2EE;color:#2C2C2C}.ai-luxury-{{ ai_gen_id }}__inner{max-width:1400px;margin:auto;display:grid;grid-template-columns:55% 45%;gap:56px}.ai-luxury-{{ ai_gen_id }}__gallery{position:sticky;top:24px;align-self:start}.ai-luxury-{{ ai_gen_id }}__main{aspect-ratio:4/5;overflow:hidden;border-radius:4px}.ai-luxury-{{ ai_gen_id }}__main img{width:100%;height:100%;object-fit:cover}.ai-luxury-{{ ai_gen_id }}__thumbs{display:flex;gap:10px;overflow:auto;padding-top:14px}.ai-luxury-{{ ai_gen_id }}__thumb{flex:0 0 72px;height:90px;padding:0;border:1px solid transparent;border-radius:4px;overflow:hidden;background:transparent}.ai-luxury-{{ ai_gen_id }}__thumb[aria-current=true]{border-color:#C9A84C}.ai-luxury-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:cover}.ai-luxury-{{ ai_gen_id }}__vendor{color:#8A6F25;font-size:12px;letter-spacing:.14em;text-transform:uppercase}.ai-luxury-{{ ai_gen_id }}__title{font:400 32px/1.15 Georgia,serif;margin:0 0 20px}.ai-luxury-{{ ai_gen_id }}__price{font-size:18px;margin-bottom:28px}.ai-luxury-{{ ai_gen_id }}__compare{text-decoration:line-through;color:#716B63;font-size:14px;margin-left:10px}.ai-luxury-{{ ai_gen_id }}__variants{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 26px}.ai-luxury-{{ ai_gen_id }}__variant{padding:11px 16px;border:1px solid #AAA39A;border-radius:14px;background:transparent}.ai-luxury-{{ ai_gen_id }}__variant[aria-pressed=true]{background:#2C2C2C;color:#F5F2EE}.ai-luxury-{{ ai_gen_id }}__buy{display:flex;gap:10px;margin-bottom:30px}.ai-luxury-{{ ai_gen_id }}__qty{display:flex;align-items:center;border:1px solid #AAA39A;border-radius:14px}.ai-luxury-{{ ai_gen_id }}__qty button{border:0;background:none;width:38px;height:48px}.ai-luxury-{{ ai_gen_id }}__qty input{width:34px;border:0;background:none;text-align:center}.ai-luxury-{{ ai_gen_id }}__submit{flex:1;border:0;border-radius:14px;background:#2C2C2C;color:#F5F2EE;text-transform:uppercase;letter-spacing:.08em}.ai-luxury-{{ ai_gen_id }}__accordion{border-top:1px solid #C9C2B8;border-bottom:1px solid #C9C2B8}.ai-luxury-{{ ai_gen_id }}__accordion summary{padding:18px 0;cursor:pointer;list-style:none}.ai-luxury-{{ ai_gen_id }}__accordion summary::-webkit-details-marker{display:none}.ai-luxury-{{ ai_gen_id }}__accordion summary:after{content:'+';float:right;color:#8A6F25;font-size:20px}.ai-luxury-{{ ai_gen_id }}__accordion[open] summary:after{content:'−'}.ai-luxury-{{ ai_gen_id }}__content{padding:0 0 18px;line-height:1.7;color:#514D48}.ai-luxury-{{ ai_gen_id }}__badges{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px}.ai-luxury-{{ ai_gen_id }}__badge{display:flex;flex-direction:column;align-items:center;gap:9px;padding:16px 8px;border:1px solid #D8C9A5;border-radius:10px;background:#FBF9F5;text-align:center;font-size:10px;letter-spacing:.08em;text-transform:uppercase}.ai-luxury-{{ ai_gen_id }}__badge svg{width:24px;height:24px;color:#9A7926}@media(max-width:749px){.ai-luxury-{{ ai_gen_id }}{padding:20px}.ai-luxury-{{ ai_gen_id }}__inner{display:block}.ai-luxury-{{ ai_gen_id }}__gallery{position:static;margin-bottom:32px}.ai-luxury-{{ ai_gen_id }}__title{font-size:28px}.ai-luxury-{{ ai_gen_id }}__badges{grid-template-columns:1fr}.ai-luxury-{{ ai_gen_id }}__badge{flex-direction:row;justify-content:flex-start;text-align:left;padding:13px 16px}}
{% endstyle %}<luxury-product-{{ ai_gen_id }} class="ai-luxury-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-luxury-{{ ai_gen_id }}__inner"><div class="ai-luxury-{{ ai_gen_id }}__gallery"><div class="ai-luxury-{{ ai_gen_id }}__main">{% if product.featured_image %}<img data-main src="{{ product.featured_image | image_url: width:1400 }}" alt="{{ product.featured_image.alt | default:product.title | escape }}">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><div class="ai-luxury-{{ ai_gen_id }}__thumbs">{% for image in product.images %}<button class="ai-luxury-{{ ai_gen_id }}__thumb" type="button" data-image="{{ image | image_url: width:1400 }}" data-alt="{{ image.alt | default:product.title | escape }}" aria-current="{% if image == product.featured_image %}true{% else %}false{% endif %}"><img src="{{ image | image_url: width:180 }}" alt="{{ image.alt | default:product.title | escape }}" loading="lazy"></button>{% endfor %}</div></div><div><p class="ai-luxury-{{ ai_gen_id }}__vendor">{{ product.vendor }}</p><h1 class="ai-luxury-{{ ai_gen_id }}__title">{{ product.title }}</h1><div class="ai-luxury-{{ ai_gen_id }}__price"><span data-price>{{ current_variant.price | money }}</span><span class="ai-luxury-{{ ai_gen_id }}__compare" data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</span></div><form action="/cart/add" method="post"><input type="hidden" name="id" data-id value="{{ current_variant.id }}"><label>Select size</label><div class="ai-luxury-{{ ai_gen_id }}__variants">{% for variant in product.variants %}<button type="button" class="ai-luxury-{{ ai_gen_id }}__variant" data-variant="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare="{{ variant.compare_at_price | money | escape }}" data-available="{{ variant.available }}" aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>{% endfor %}</div><div class="ai-luxury-{{ ai_gen_id }}__buy"><div class="ai-luxury-{{ ai_gen_id }}__qty"><button type="button" data-minus>−</button><input name="quantity" type="number" min="1" value="1" data-qty><button type="button" data-plus>+</button></div><button class="ai-luxury-{{ ai_gen_id }}__submit" type="submit" name="add">Add to cart</button></div></form><details class="ai-luxury-{{ ai_gen_id }}__accordion" open><summary>Product details</summary><div class="ai-luxury-{{ ai_gen_id }}__content">{{ product.description }}</div></details><div class="ai-luxury-{{ ai_gen_id }}__badges"><div class="ai-luxury-{{ ai_gen_id }}__badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>Free shipping</div><div class="ai-luxury-{{ ai_gen_id }}__badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 11a8 8 0 1 1-2.3-5.7M20 4v7h-7"/><path d="m8 12 2 2 5-5"/></svg>Easy returns</div><div class="ai-luxury-{{ ai_gen_id }}__badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 5 6v5c0 4.5 2.9 8.4 7 10 4.1-1.6 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>Authenticity guaranteed</div></div></div></div></luxury-product-{{ ai_gen_id }}><script>(function(){class LP{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.q=s=>this.querySelector(s);this.querySelectorAll('[data-image]').forEach(b=>b.onclick=()=>{let i=this.q('[data-main]');if(i){i.src=b.dataset.image;i.alt=b.dataset.alt}this.querySelectorAll('[data-image]').forEach(x=>x.setAttribute('aria-current','false'));b.setAttribute('aria-current','true')});this.querySelectorAll('[data-variant]').forEach(b=>b.onclick=()=>{this.q('[data-id]').value=b.dataset.variant;this.q('[data-price]').textContent=b.dataset.price;this.q('[data-compare]').hidden=!b.dataset.compare||b.dataset.compare==b.dataset.price;this.q('[data-compare]').textContent=b.dataset.compare;this.querySelectorAll('[data-variant]').forEach(x=>x.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');this.q('[name=add]').disabled=b.dataset.available!='true'});this.q('[data-minus]').onclick=()=>this.q('[data-qty]').value=Math.max(1,+this.q('[data-qty]').value-1);this.q('[data-plus]').onclick=()=>this.q('[data-qty]').value=+this.q('[data-qty]').value+1}}customElements.define('lp-{{ ai_gen_id }}',LP{{ ai_gen_id }})})()</script>{% schema %}{"name":"Luxury product details","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Luxury product details"}],"tag":null,"class":"luxury-product-block"}{% endschema %}