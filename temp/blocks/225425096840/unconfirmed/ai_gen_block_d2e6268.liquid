{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-product-info-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; padding: 28px; background: #F5F2EE; color: #2C2C2C; }
  .ai-product-info-{{ ai_gen_id }}__image { width: 100%; margin-bottom: 24px; background: transparent; }
  .ai-product-info-{{ ai_gen_id }}__image img { display: block; width: 100%; height: auto; object-fit: cover; }
  .ai-product-info-{{ ai_gen_id }}__vendor { margin: 0 0 8px; color: #8A6A20; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
  .ai-product-info-{{ ai_gen_id }}__title { margin: 0 0 12px; font-family: Georgia, serif; font-size: 32px; line-height: 1.2; }
  .ai-product-info-{{ ai_gen_id }}__price { margin: 0 0 22px; font-size: 18px; font-weight: 600; }
  .ai-product-info-{{ ai_gen_id }}__compare { margin-left: 8px; color: #686868; font-size: 14px; font-weight: 400; }
  .ai-product-info-{{ ai_gen_id }}__details { border-top: 1px solid #C9A84C; padding-top: 20px; }
  .ai-product-info-{{ ai_gen_id }}__details h2 { margin: 0 0 12px; font-family: Georgia, serif; font-size: 24px; }
  .ai-product-info-{{ ai_gen_id }}__description { font-size: 15px; line-height: 1.7; }
  .ai-product-info-{{ ai_gen_id }}__description p { margin: 0 0 14px; }
  .ai-product-info-{{ ai_gen_id }}__description ul, .ai-product-info-{{ ai_gen_id }}__description ol { margin: 0 0 14px; padding-left: 22px; }
  @media screen and (max-width: 749px) { .ai-product-info-{{ ai_gen_id }} { width: 100%; padding: 22px; } .ai-product-info-{{ ai_gen_id }}__title { font-size: 28px; } }
{% endstyle %}

<div class="ai-product-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if product.featured_image %}
    <div class="ai-product-info-{{ ai_gen_id }}__image">
      <img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
    </div>
  {% endif %}
  {% if product.vendor != blank %}<p class="ai-product-info-{{ ai_gen_id }}__vendor">{{ product.vendor }}</p>{% endif %}
  <h1 class="ai-product-info-{{ ai_gen_id }}__title">{{ product.title }}</h1>
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% if current_variant %}
    <p class="ai-product-info-{{ ai_gen_id }}__price">
      {{ current_variant.price | money }}
      {% if current_variant.compare_at_price > current_variant.price %}<span class="ai-product-info-{{ ai_gen_id }}__compare">{{ current_variant.compare_at_price | money }}</span>{% endif %}
    </p>
  {% endif %}
  {% if product.description != blank %}
    <section class="ai-product-info-{{ ai_gen_id }}__details">
      <h2>{{ block.settings.heading }}</h2>
      <div class="ai-product-info-{{ ai_gen_id }}__description">{{ product.description }}</div>
    </section>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product information data",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Product information data" }],
  "tag": null,
  "class": "product-information-data-block"
}
{% endschema %}