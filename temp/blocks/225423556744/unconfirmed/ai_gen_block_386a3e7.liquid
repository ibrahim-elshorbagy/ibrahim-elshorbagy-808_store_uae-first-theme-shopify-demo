{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign current_product = product %}
{% style %}
  .ai-product-{{ ai_gen_id }}{display:block;background:#f5f2ee;color:#2c2c2c}
  .ai-product-{{ ai_gen_id }}__wrap{width:{{ block.settings.desktop_width_percent }}%;max-width:1400px;margin:0 auto;padding:60px;display:grid;grid-template-columns:55fr 45fr;gap:56px}
  .ai-product-{{ ai_gen_id }}__media{position:sticky;top:24px;align-self:start}.ai-product-{{ ai_gen_id }}__main{aspect-ratio:4/5;overflow:hidden;background:transparent;border-radius:4px}.ai-product-{{ ai_gen_id }}__main img,.ai-product-{{ ai_gen_id }}__main video{width:100%;height:100%;object-fit:cover;display:block;background:transparent;transition:transform .4s ease}.ai-product-{{ ai_gen_id }}__main:hover img{transform:scale(1.08)}
  .ai-product-{{ ai_gen_id }}__thumbs{display:flex;gap:10px;overflow:auto;padding-top:14px}.ai-product-{{ ai_gen_id }}__thumb{flex:0 0 72px;height:90px;padding:0;border:2px solid transparent;border-radius:4px;overflow:hidden;background:transparent;cursor:pointer}.ai-product-{{ ai_gen_id }}__thumb:hover,.ai-product-{{ ai_gen_id }}__thumb[aria-current=true]{border-color:#c9a84c}.ai-product-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:cover}
  .ai-product-{{ ai_gen_id }}__vendor{margin:0 0 12px;color:#9b7b2e;font-size:11px;letter-spacing:.15em;text-transform:uppercase}.ai-product-{{ ai_gen_id }} h1{margin:0 0 18px;font-size:32px;line-height:1.2}.ai-product-{{ ai_gen_id }}__rating{color:#c9a84c;margin-bottom:18px}.ai-product-{{ ai_gen_id }}__rating a{color:#666;font-size:13px;margin-left:8px}.ai-product-{{ ai_gen_id }}__price{font-size:24px;margin-bottom:22px}.ai-product-{{ ai_gen_id }}__compare{color:#999;text-decoration:line-through;font-size:15px;margin-right:10px}.ai-product-{{ ai_gen_id }}__sale{color:#c0392b}.ai-product-{{ ai_gen_id }}__rule{border:0;border-top:1px solid #e0ddd8;margin:20px 0}
  .ai-product-{{ ai_gen_id }}__description{color:#666;font-size:14px;line-height:1.7;max-height:4.8em;overflow:hidden}.ai-product-{{ ai_gen_id }}__description.is-open{max-height:1000px}.ai-product-{{ ai_gen_id }}__read{border:0;background:none;color:#9b7b2e;padding:8px 0;text-decoration:underline;cursor:pointer}.ai-product-{{ ai_gen_id }}__label{display:flex;justify-content:space-between;margin:22px 0 10px;font-size:13px;font-weight:600}.ai-product-{{ ai_gen_id }}__label a{color:#9b7b2e;font-weight:400}.ai-product-{{ ai_gen_id }}__options{display:flex;flex-wrap:wrap;gap:8px}.ai-product-{{ ai_gen_id }}__option input{position:absolute;opacity:0}.ai-product-{{ ai_gen_id }}__option label{display:flex;align-items:center;justify-content:center;min-width:48px;height:40px;padding:0 14px;border:1px solid #d0ccc6;border-radius:24px;background:#fff;cursor:pointer}.ai-product-{{ ai_gen_id }}__option input:checked+label{background:#2c2c2c;color:#fff}.ai-product-{{ ai_gen_id }}__qty{display:flex}.ai-product-{{ ai_gen_id }}__qty button,.ai-product-{{ ai_gen_id }}__qty input{width:36px;height:36px;border:1px solid #d0ccc6;background:#fff;text-align:center}.ai-product-{{ ai_gen_id }}__qty input{width:48px;border-left:0;border-right:0}.ai-product-{{ ai_gen_id }}__button{width:100%;height:52px;border:0;border-radius:4px;cursor:pointer;letter-spacing:.1em;text-transform:uppercase;box-shadow:0 2px 8px #0000001a;font-size:15px;margin-top:12px;background:#2c2c2c;color:#fff}.ai-product-{{ ai_gen_id }}__trust{display:flex;justify-content:space-between;gap:10px;color:#888;font-size:12px;padding:22px 0}.ai-product-{{ ai_gen_id }}__trust span{color:#9b7b2e;font-size:18px;display:block}.ai-product-{{ ai_gen_id }}__accordion{border-bottom:1px solid #e0ddd8}.ai-product-{{ ai_gen_id }}__accordion button{width:100%;padding:16px 0;border:0;background:none;display:flex;justify-content:space-between;cursor:pointer;text-align:left}.ai-product-{{ ai_gen_id }}__panel{display:none;padding:0 0 16px;color:#666;font-size:14px;line-height:1.7}.ai-product-{{ ai_gen_id }}__accordion.is-open .ai-product-{{ ai_gen_id }}__panel{display:block}.ai-product-{{ ai_gen_id }}__share{padding-top:24px;color:#888}.ai-product-{{ ai_gen_id }}__share a{color:#2c2c2c;margin-left:12px;text-decoration:none;font-size:18px}@media(max-width:749px){.ai-product-{{ ai_gen_id }}__wrap{width:100%;display:block;padding:20px}.ai-product-{{ ai_gen_id }}__media{position:static;margin-bottom:36px}.ai-product-{{ ai_gen_id }}__thumbs{display:none}.ai-product-{{ ai_gen_id }}__main{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.ai-product-{{ ai_gen_id }}__main img,.ai-product-{{ ai_gen_id }}__main video{min-width:100%;scroll-snap-align:start}.ai-product-{{ ai_gen_id }} h1{font-size:24px}}
{% endstyle %}
<product-page-{{ ai_gen_id }} class="ai-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-product-{{ ai_gen_id }}__wrap"><div class="ai-product-{{ ai_gen_id }}__media"><div class="ai-product-{{ ai_gen_id }}__main" data-main>{% if current_product.media.size > 0 %}{% for media in current_product.media limit: 8 %}{% if media.media_type == 'image' %}<img src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | default: current_product.title | escape }}" loading="lazy">{% elsif media.media_type == 'video' %}{{ media | video_tag: controls: true, image_size: '1600x' }}{% endif %}{% endfor %}{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-product-{{ ai_gen_id }}__thumbs">{% for media in current_product.media limit: 8 %}<button class="ai-product-{{ ai_gen_id }}__thumb" type="button" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ media.preview_image | image_url: width: 180 }}" alt="{{ media.alt | default: current_product.title | escape }}"></button>{% endfor %}</div></div><div>{% if current_product.vendor != blank %}<p class="ai-product-{{ ai_gen_id }}__vendor">{{ current_product.vendor }}</p>{% endif %}{% unless current_product.title == 'Default Title' or current_product.title == blank %}<h1>{{ current_product.title }}</h1>{% endunless %}<div class="ai-product-{{ ai_gen_id }}__rating">★★★★★ <a href="#reviews-{{ ai_gen_id }}">{{ block.settings.rating }} · {{ block.settings.review_count }} reviews</a></div><div class="ai-product-{{ ai_gen_id }}__price">{% if current_product.compare_at_price > current_product.price %}<span class="ai-product-{{ ai_gen_id }}__compare">{{ current_product.compare_at_price | money }}</span><span class="ai-product-{{ ai_gen_id }}__sale">{{ current_product.price | money }}</span>{% else %}{{ current_product.price | money }}{% endif %}</div><hr class="ai-product-{{ ai_gen_id }}__rule"><div class="ai-product-{{ ai_gen_id }}__description" data-description>{{ current_product.description }}</div><button class="ai-product-{{ ai_gen_id }}__read" type="button" data-read>Read more</button>{% form 'product', current_product %}<input type="hidden" name="id" value="{{ current_product.selected_or_first_available_variant.id }}">{% for option in current_product.options_with_values %}{% unless option.name == 'Title' and option.values.size == 1 and option.values.first == 'Default Title' %}<div class="ai-product-{{ ai_gen_id }}__label"><span>{{ option.name }}</span></div><div class="ai-product-{{ ai_gen_id }}__options">{% for value in option.values %}<div class="ai-product-{{ ai_gen_id }}__option"><input type="radio" id="{{ ai_gen_id }}-{{ option.position }}-{{ forloop.index }}" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}><label for="{{ ai_gen_id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label></div>{% endfor %}</div>{% endunless %}{% endfor %}<div class="ai-product-{{ ai_gen_id }}__label"><span>Quantity</span></div><div class="ai-product-{{ ai_gen_id }}__qty"><button type="button" data-minus aria-label="Decrease quantity">−</button><input name="quantity" value="1" min="1" type="number" aria-label="Quantity"><button type="button" data-plus aria-label="Increase quantity">+</button></div><button class="ai-product-{{ ai_gen_id }}__button" type="submit">Add to cart</button>{% endform %}<div class="ai-product-{{ ai_gen_id }}__trust"><div><span>✦</span>Free shipping</div><div><span>↺</span>Easy returns</div><div><span>◆</span>Authenticity guaranteed</div></div>{% assign accordion_titles = 'Product details|Shipping & returns|Size & fit' | split: '|' %}{% for title in accordion_titles %}<div class="ai-product-{{ ai_gen_id }}__accordion"><button type="button" aria-expanded="false">{{ title }} <b>+</b></button><div class="ai-product-{{ ai_gen_id }}__panel">{{ block.settings.accordion_text }}</div></div>{% endfor %}<div class="ai-product-{{ ai_gen_id }}__share">Share: <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ current_product.url | url_param_escape }}" target="_blank" rel="noopener">f</a><a href="https://wa.me/?text={{ current_product.title | url_param_escape }}" target="_blank" rel="noopener">◉</a><a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ current_product.url | url_param_escape }}" target="_blank" rel="noopener">p</a></div></div></div></product-page-{{ ai_gen_id }}>
<script>(function(){class ProductPage{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.main=this.querySelector('[data-main]');this.querySelectorAll('[data-index]').forEach(b=>b.addEventListener('click',()=>{this.main.children[b.dataset.index]?.scrollIntoView({behavior:'smooth',inline:'center'});this.querySelectorAll('[data-index]').forEach(x=>x.setAttribute('aria-current','false'));b.setAttribute('aria-current','true')}));this.querySelector('[data-read]').addEventListener('click',()=>this.querySelector('[data-description]').classList.toggle('is-open'));this.querySelectorAll('[data-minus],[data-plus]').forEach(b=>b.addEventListener('click',()=>{let i=this.querySelector('[name="quantity"]'),v=parseInt(i.value||1);i.value=b.hasAttribute('data-plus')?v+1:Math.max(1,v-1)}));this.querySelectorAll('.ai-product-{{ ai_gen_id }}__accordion button').forEach(b=>b.addEventListener('click',()=>{let a=b.parentElement;a.classList.toggle('is-open');b.setAttribute('aria-expanded',a.classList.contains('is-open'));b.querySelector('b').textContent=a.classList.contains('is-open')?'−':'+'}))}}customElements.define('product-page-{{ ai_gen_id }}',ProductPage{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Editorial product page","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"text","id":"rating","label":"Rating","default":"4.8"},{"type":"text","id":"review_count","label":"Review count","default":"142"},{"type":"textarea","id":"accordion_text","label":"Accordion text","default":"Crafted for everyday refinement. Please check our policies for current delivery and return details."}],"presets":[{"name":"Editorial product page"}],"tag":null,"class":"editorial-product-page"}{% endschema %}