{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-social-{{ ai_gen_id }}{display:flex;align-items:center;gap:14px;padding:18px 0;color:#777;font-size:13px}.ai-social-{{ ai_gen_id }}__label{margin-right:2px}.ai-social-{{ ai_gen_id }}__link{display:inline-flex;width:34px;height:34px;align-items:center;justify-content:center;border:1px solid #d0ccc6;border-radius:50%;background:#fff;color:#2c2c2c;text-decoration:none;transition:all .2s ease}.ai-social-{{ ai_gen_id }}__link:hover{background:#c9a84c;border-color:#c9a84c;color:#2c2c2c}.ai-social-{{ ai_gen_id }}__link svg{width:16px;height:16px;display:block;fill:currentColor}@media(max-width:749px){.ai-social-{{ ai_gen_id }}{gap:10px}}
{% endstyle %}
<div class="ai-social-{{ ai_gen_id }}" {{ block.shopify_attributes }}><span class="ai-social-{{ ai_gen_id }}__label">Share:</span><a class="ai-social-{{ ai_gen_id }}__link" href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url | url_param_escape }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V4a22 22 0 0 0-2.4-.1c-2.4 0-4 1.5-4 4.1V10H8v3h2.4v8h3.1Z"/></svg></a><a class="ai-social-{{ ai_gen_id }}__link" href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url | url_param_escape }}&description={{ product.title | url_param_escape }}" target="_blank" rel="noopener" aria-label="Save on Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-1.5 0-3.2.4-4.6l1-4.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.8-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.4-.3 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.7 0-2.5-1.8-4.3-4.4-4.3-3 0-4.8 2.2-4.8 4.6 0 .9.3 1.9.8 2.4.1.1.1.2.1.4l-.3 1.1c-.1.4-.4.5-.7.3-1.3-.6-2.1-2.5-2.1-4.1 0-3.4 2.5-6.6 7.3-6.6 3.8 0 6.8 2.7 6.8 6.2 0 3.7-2.3 6.7-5.5 6.7-1.1 0-2.2-.6-2.5-1.3l-.7 2.6c-.3 1-.9 2.2-1.4 3A9 9 0 1 0 12 3Z"/></svg></a><a class="ai-social-{{ ai_gen_id }}__link" href="https://wa.me/?text={{ product.title | append:' ' | append:shop.url | append:product.url | url_param_escape }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Zm0 16.3c-1.4 0-2.8-.4-4-1.1l-.3-.2-2.8.7.7-2.7-.2-.3A7.2 7.2 0 1 1 12 19.3Zm4-5.3c-.2-.1-1.3-.7-1.5-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.1-.3.2-.5.1a5.8 5.8 0 0 1-2.9-2.5c-.1-.2 0-.3.1-.4l.4-.5c.1-.1.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.4c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.1s.9 2.4 1 2.5c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.1 1.6.1.5-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1-.1-.1-.2-.1-.4-.2Z"/></svg></a><button class="ai-social-{{ ai_gen_id }}__link" type="button" data-copy aria-label="Copy product link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h10v12H8V8Zm-2 2H4V4h12v2H6v4Zm4 3h6v2h-6v-2Zm0 4h6v2h-6v-2Z"/></svg></button></div>
<script>(function(){var r=document.querySelector('.ai-social-{{ ai_gen_id }}');if(!r)return;var b=r.querySelector('[data-copy]');b.addEventListener('click',function(){navigator.clipboard.writeText(window.location.href).then(function(){b.setAttribute('aria-label','Link copied');setTimeout(function(){b.setAttribute('aria-label','Copy product link')},1500)})})})();</script>
