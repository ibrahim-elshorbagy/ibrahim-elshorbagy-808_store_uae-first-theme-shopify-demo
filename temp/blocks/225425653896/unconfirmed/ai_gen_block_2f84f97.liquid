{% doc %}
  @prompt
    Create a complete NEW product page section for a premium men's luxury footwear brand. Everything must use real Shopify Liquid data — no hardcoded or placeholder content.
    
    LAYOUT:
    - Two column desktop layout: left column 55% for image gallery, right column 45% for product info
    - Single column on mobile, images on top
    - Cream/ivory background (#F5F2EE), charcoal text (#2C2C2C), gold accents (#C9A84C)
    - Max width 1400px centered, 60px side padding desktop, 20px mobile
    
    LEFT COLUMN - IMAGE GALLERY:
    - Main image using product.featured_image, aspect ratio 4:5, object-fit cover
    - Thumbnail strip below showing all product.images, each 72x90px, border-radius 4px
    - Clicking thumbnail swaps main image using JavaScript
    - Sticky on desktop as user scrolls
    
    RIGHT COLUMN - PRODUCT INFO:
    - Vendor: {{ product.vendor }} in small gold uppercase text
    - Title: {{ product.title }} large serif font 32px
    - Price: {{ product.selected_or_first_available_variant.price | money }}, show compare_at_price struck through if on sale
    - Variant picker: loop through product.variants, show as pill buttons, clicking updates hidden form input
    - Quantity stepper: minus/plus buttons with number input, minimum 1
    - ADD TO CART: real working form with action="/cart/add" method="post", hidden input name="id" with variant id, quantity input, submit button with name="add"
    - Accordions for: product.description, Shipping and Returns, Size and Fit — smooth open/close animation
    - Trust badges row: Free Shipping, Easy Returns, Authenticity Guaranteed
    
    All JavaScript must be inline and functional. All data must come from Shopify Liquid objects.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign current_variant = product.selected_or_first_available_variant %}{% style %}.ai-p-{{ai_gen_id}}{display:block;width:100%;background:#F5F2EE;color:#2C2C2C}.ai-p-{{ai_gen_id}}__in{width:{{block.settings.desktop_width_percent}}%;max-width:1400px;margin:auto;padding:60px;display:grid;grid-template-columns:55fr 45fr;gap:64px;box-sizing:border-box}.ai-p-{{ai_gen_id}}__gallery{position:sticky;top:24px;align-self:start}.ai-p-{{ai_gen_id}}__main{aspect-ratio:4/5;overflow:hidden}.ai-p-{{ai_gen_id}}__main img{width:100%;height:100%;object-fit:cover;display:block}.ai-p-{{ai_gen_id}}__thumbs{display:flex;gap:10px;overflow:auto;margin-top:14px}.ai-p-{{ai_gen_id}}__thumb{width:72px;height:90px;flex:0 0 72px;padding:0;border:1px solid transparent;border-radius:4px;background:transparent;cursor:pointer;overflow:hidden}.ai-p-{{ai_gen_id}}__thumb.is-active{border-color:#C9A84C}.ai-p-{{ai_gen_id}}__thumb img{width:100%;height:100%;object-fit:cover}.ai-p-{{ai_gen_id}}__vendor{color:#8A6B20;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700}.ai-p-{{ai_gen_id}}__title{font-family:{{settings.type_heading_font.family}},serif;font-size:32px;line-height:1.15;margin:0 0 20px}.ai-p-{{ai_gen_id}}__price{font-size:18px;margin-bottom:30px}.ai-p-{{ai_gen_id}}__compare{margin-left:10px;color:#777;text-decoration:line-through;font-size:14px}.ai-p-{{ai_gen_id}}__label{display:block;margin:0 0 10px;font-size:12px;font-weight:700;text-transform:uppercase}.ai-p-{{ai_gen_id}}__variants{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}.ai-p-{{ai_gen_id}}__variant{padding:10px 14px;border:1px solid #999;border-radius:14px;background:transparent;color:#2C2C2C;cursor:pointer}.ai-p-{{ai_gen_id}}__variant.is-selected{background:#2C2C2C;color:#F5F2EE}.ai-p-{{ai_gen_id}}__quantity{display:flex;width:max-content;border:1px solid #999;border-radius:14px;overflow:hidden;margin-bottom:14px}.ai-p-{{ai_gen_id}}__quantity button{width:38px;border:0;background:transparent;font-size:20px;cursor:pointer}.ai-p-{{ai_gen_id}}__quantity input{width:42px;text-align:center;border:0;background:transparent}.ai-p-{{ai_gen_id}}__add{width:100%;padding:16px;border:0;border-radius:14px;background:#2C2C2C;color:#F5F2EE;font-weight:700;text-transform:uppercase;cursor:pointer}.ai-p-{{ai_gen_id}}__accordions{margin-top:34px;border-top:1px solid #C9A84C}.ai-p-{{ai_gen_id}}__accordion{border-bottom:1px solid #c8c2b8}.ai-p-{{ai_gen_id}}__accordion summary{padding:18px 0;cursor:pointer;font-weight:700;list-style:none}.ai-p-{{ai_gen_id}}__accordion summary::-webkit-details-marker{display:none}.ai-p-{{ai_gen_id}}__content{padding:0 0 20px;line-height:1.7;font-size:14px}.ai-p-{{ai_gen_id}}__trust{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px;color:#6B541B;font-size:11px;font-weight:700}.ai-p-{{ai_gen_id}}__trust span{padding-right:14px;border-right:1px solid #C9A84C}.ai-p-{{ai_gen_id}}__trust span:last-child{border:0}@media(max-width:749px){.ai-p-{{ai_gen_id}}__in{width:100%;padding:20px;display:block}.ai-p-{{ai_gen_id}}__gallery{position:static}.ai-p-{{ai_gen_id}}__info{padding-top:34px}.ai-p-{{ai_gen_id}}__title{font-size:28px}}{% endstyle %}<product-page-{{ai_gen_id}} class="ai-p-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-p-{{ai_gen_id}}__in"><div class="ai-p-{{ai_gen_id}}__gallery"><div class="ai-p-{{ai_gen_id}}__main"><img data-main src="{{product.featured_image | image_url: width: 1400}}" alt="{{product.featured_image.alt | default: product.title | escape}}"></div><div class="ai-p-{{ai_gen_id}}__thumbs">{% for image in product.images %}<button type="button" class="ai-p-{{ai_gen_id}}__thumb{% if forloop.first %} is-active{% endif %}" data-image="{{image | image_url: width: 1400}}" data-alt="{{image.alt | default: product.title | escape}}" aria-label="View image {{forloop.index}}"><img src="{{image | image_url: width: 180}}" alt="{{image.alt | default: product.title | escape}}" loading="lazy"></button>{% endfor %}</div></div><div class="ai-p-{{ai_gen_id}}__info"><p class="ai-p-{{ai_gen_id}}__vendor">{{product.vendor}}</p><h1 class="ai-p-{{ai_gen_id}}__title">{{product.title}}</h1><div class="ai-p-{{ai_gen_id}}__price">{{current_variant.price | money}}{% if current_variant.compare_at_price > current_variant.price %}<span class="ai-p-{{ai_gen_id}}__compare">{{current_variant.compare_at_price | money}}</span>{% endif %}</div>{% form 'product', product %}<input type="hidden" name="id" value="{{current_variant.id}}" data-id>{% unless product.has_only_default_variant %}<span class="ai-p-{{ai_gen_id}}__label">Select variant</span><div class="ai-p-{{ai_gen_id}}__variants">{% for variant in product.variants %}<button type="button" class="ai-p-{{ai_gen_id}}__variant{% if variant.id == current_variant.id %} is-selected{% endif %}" data-variant="{{variant.id}}"{% unless variant.available %} disabled{% endunless %}>{{variant.title}}</button>{% endfor %}</div>{% endunless %}<span class="ai-p-{{ai_gen_id}}__label">Quantity</span><div class="ai-p-{{ai_gen_id}}__quantity"><button type="button" data-minus aria-label="Decrease quantity">−</button><input type="number" name="quantity" value="1" min="1" data-qty aria-label="Quantity"><button type="button" data-plus aria-label="Increase quantity">+</button></div><button type="submit" name="add" class="ai-p-{{ai_gen_id}}__add">Add to cart</button>{% endform %}<div class="ai-p-{{ai_gen_id}}__accordions"><details class="ai-p-{{ai_gen_id}}__accordion"><summary>Product details</summary><div class="ai-p-{{ai_gen_id}}__content">{{product.description}}</div></details><details class="ai-p-{{ai_gen_id}}__accordion"><summary>Shipping and returns</summary><div class="ai-p-{{ai_gen_id}}__content">{{product.metafields.custom.shipping_returns | metafield_tag}}</div></details><details class="ai-p-{{ai_gen_id}}__accordion"><summary>Size and fit</summary><div class="ai-p-{{ai_gen_id}}__content">{{product.metafields.custom.size_fit | metafield_tag}}</div></details></div><div class="ai-p-{{ai_gen_id}}__trust"><span>Free shipping</span><span>Easy returns</span><span>Authenticity guaranteed</span></div></div></div></product-page-{{ai_gen_id}}><script>(function(){class P{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.m=this.querySelector('[data-main]');this.id=this.querySelector('[data-id]');this.q=this.querySelector('[data-qty]');this.querySelectorAll('[data-image]').forEach(b=>b.onclick=()=>{this.m.src=b.dataset.image;this.m.alt=b.dataset.alt;this.querySelectorAll('[data-image]').forEach(x=>x.classList.remove('is-active'));b.classList.add('is-active')});this.querySelectorAll('[data-variant]').forEach(b=>b.onclick=()=>{this.id.value=b.dataset.variant;this.querySelectorAll('[data-variant]').forEach(x=>x.classList.remove('is-selected'));b.classList.add('is-selected')});this.querySelector('[data-minus]').onclick=()=>this.q.value=Math.max(1,+this.q.value-1);this.querySelector('[data-plus]').onclick=()=>this.q.value=+this.q.value+1}}customElements.define('product-page-{{ai_gen_id}}',P{{ai_gen_id}})})();</script>{% schema %}{"name":"Luxury product page","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Luxury product page"}],"tag":null,"class":"luxury-product-page"}{% endschema %}