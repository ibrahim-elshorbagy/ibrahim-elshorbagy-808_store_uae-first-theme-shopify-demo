{% doc %}
  @prompt
    make this for shopify <!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hero 17 — Leather Slash</title><link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Merriweather:ital,wght@0,400;1,400&display=swap" rel="stylesheet"><style>*{margin:0;box-sizing:border-box}body{font-family:"Merriweather",serif}.hero{min-height:100svh;display:grid;grid-template-columns:1fr 1fr;background:#201812;color:#f3e7d3}.copy{padding:64px 54px;display:flex;flex-direction:column;justify-content:center}.copy h1{font-family:Oswald,sans-serif;font-weight:700;text-transform:uppercase;font-size:clamp(52px,6.5vw,96px);line-height:.92}.copy h1 span{color:#e0a458}.slash{background:#e0a458;min-height:400px;clip-path:polygon(14% 0,100% 0,100% 100%,0 100%);position:relative}.slash img{width:100%;height:100%;min-height:100svh;object-fit:cover;display:block;filter:sepia(.25) contrast(1.05)}.num{position:absolute;bottom:20px;right:20px;background:#201812;color:#e0a458;font-family:Oswald;font-size:44px;padding:6px 18px}.b{font-family:Oswald;background:#e0a458;color:#201812;font-weight:700;letter-spacing:.06em;padding:17px 36px;text-decoration:none;width:fit-content;margin-top:24px}@media(max-width:850px){.hero{grid-template-columns:1fr}.slash{clip-path:none}.slash img{min-height:52vh}}</style></head><body><section class="hero"><div class="copy"><div style="font-size:11px;letter-spacing:.4em;color:#e0a458">CUT N°17 — FULL GRAIN</div><h1>HAND<br><span>BURNISHED.</span><br>MACHINE NONE.</h1><p style="font-style:italic;font-size:14px;color:#c9b797;margin-top:12px">Tan leather, hand-rubbed edges. Ages like a good story.</p><a class="b" href="#">SHOP LEATHER — 389 AED</a></div><div class="slash"><img src="../Brown_suede_loafers_on_podium_20260917221440.jpeg" alt="Leather loafers" onerror="this.remove()"><div class="num">17</div></div></section></body></html>
    , delete the number 17 box from corner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-leather-hero-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; min-height:min(760px,100svh); background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; }
  .ai-leather-hero-{{ ai_gen_id }}__inner { display:grid; grid-template-columns:1fr 1fr; min-height:min(760px,100svh); }
  .ai-leather-hero-{{ ai_gen_id }}__copy { display:flex; flex-direction:column; justify-content:center; align-items:flex-start; padding:64px 54px; }
  .ai-leather-hero-{{ ai_gen_id }}__eyebrow { margin:0 0 22px; color:{{ block.settings.accent_color }}; font-family:{{ settings.type_accent_font.family }},sans-serif; font-size:11px; font-weight:700; letter-spacing:.35em; line-height:1.4; text-transform:uppercase; }
  .ai-leather-hero-{{ ai_gen_id }}__heading { max-width:680px; margin:0; color:{{ block.settings.heading_color }}; font-family:{{ settings.type_heading_font.family }},sans-serif; font-size:clamp(52px,6.5vw,96px); font-weight:700; letter-spacing:-.045em; line-height:.92; text-transform:uppercase; }
  .ai-leather-hero-{{ ai_gen_id }}__heading-accent { color:{{ block.settings.accent_color }}; }
  .ai-leather-hero-{{ ai_gen_id }}__description { max-width:450px; margin:18px 0 0; color:{{ block.settings.muted_text_color }}; font-family:{{ settings.type_body_font.family }},sans-serif; font-size:14px; font-style:italic; line-height:1.6; }
  .ai-leather-hero-{{ ai_gen_id }}__button { display:inline-flex; align-items:center; justify-content:center; min-height:52px; margin-top:26px; padding:15px 30px; background:{{ block.settings.accent_color }}; color:{{ block.settings.button_text_color }}; font-family:{{ settings.type_accent_font.family }},sans-serif; font-size:14px; font-weight:700; letter-spacing:.06em; text-decoration:none; text-transform:uppercase; }
  .ai-leather-hero-{{ ai_gen_id }}__button:focus-visible { outline:3px solid {{ block.settings.focus_color }}; outline-offset:4px; }
  .ai-leather-hero-{{ ai_gen_id }}__media { position:relative; min-height:400px; overflow:hidden; background:{{ block.settings.image_placeholder_color }}; clip-path:polygon(14% 0,100% 0,100% 100%,0 100%); }
  .ai-leather-hero-{{ ai_gen_id }}__media img { display:block; width:100%; height:100%; min-height:min(760px,100svh); object-fit:cover; filter:sepia(.25) contrast(1.05); }
  .ai-leather-hero-{{ ai_gen_id }}__placeholder { display:flex; align-items:center; justify-content:center; width:100%; height:100%; min-height:min(760px,100svh); }
  .ai-leather-hero-{{ ai_gen_id }}__placeholder svg { width:55%; height:55%; opacity:.35; }
  .ai-leather-hero-{{ ai_gen_id }}__empty-state { position:absolute; right:24px; bottom:24px; left:24px; color:{{ block.settings.muted_text_color }}; font-family:{{ settings.type_body_font.family }},sans-serif; font-size:13px; text-align:center; }
  @media screen and (max-width:850px) { .ai-leather-hero-{{ ai_gen_id }}__inner { grid-template-columns:1fr; } .ai-leather-hero-{{ ai_gen_id }}__copy { min-height:520px; padding:48px 28px; } .ai-leather-hero-{{ ai_gen_id }}__media { min-height:52vh; clip-path:none; } .ai-leather-hero-{{ ai_gen_id }}__media img,.ai-leather-hero-{{ ai_gen_id }}__placeholder { min-height:52vh; } }
{% endstyle %}
<div class="ai-leather-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-leather-hero-{{ ai_gen_id }}__inner">
    <div class="ai-leather-hero-{{ ai_gen_id }}__copy">
      {% if block.settings.eyebrow != blank %}<p class="ai-leather-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h1 class="ai-leather-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading_line_one | escape }}<br><span class="ai-leather-hero-{{ ai_gen_id }}__heading-accent">{{ block.settings.heading_line_two | escape }}</span><br>{{ block.settings.heading_line_three | escape }}</h1>
      {% if block.settings.description != blank %}<p class="ai-leather-hero-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>{% endif %}
      {% if block.settings.button_link != blank %}<a class="ai-leather-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}{% if block.settings.product != blank %} — {{ block.settings.product.price | money }}{% endif %}</a>{% endif %}
    </div>
    <div class="ai-leather-hero-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width:1600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-leather-hero-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-leather-hero-{{ ai_gen_id }}__empty-state">Add an image to showcase your leather collection.</span></div>{% endif %}
    </div>
  </div>
</div>
{% schema %}
{"name":"Leather slash hero","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Cut N°17 — Full grain"},{"type":"text","id":"heading_line_one","label":"First line","default":"Hand"},{"type":"text","id":"heading_line_two","label":"Accent line","default":"Burnished."},{"type":"text","id":"heading_line_three","label":"Third line","default":"Machine none."},{"type":"textarea","id":"description","label":"Description","default":"Tan leather, hand-rubbed edges. Ages like a good story."},{"type":"text","id":"button_label","label":"Button label","default":"Shop leather"},{"type":"url","id":"button_link","label":"Button link"},{"type":"product","id":"product","label":"Product price"},{"type":"header","content":"Media"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#201812"},{"type":"color","id":"text_color","label":"Text","default":"#F3E7D3"},{"type":"color","id":"heading_color","label":"Heading","default":"#F3E7D3"},{"type":"color","id":"accent_color","label":"Accent","default":"#E0A458"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#C9B797"},{"type":"color","id":"button_text_color","label":"Button text","default":"#201812"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#FFFFFF"},{"type":"color","id":"image_placeholder_color","label":"Image placeholder","default":"#6B4A35"}],"presets":[{"name":"Leather slash hero"}],"tag":null,"class":"leather-slash-hero-block"}
{% endschema %}