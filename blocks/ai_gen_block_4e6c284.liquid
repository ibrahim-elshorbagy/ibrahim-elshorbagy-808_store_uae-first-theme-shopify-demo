{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-masonry-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 24px;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__heading {
    margin: 0;
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__intro {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__viewport {
    overflow: hidden;
    margin-top: 28px;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__track {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.card_gap }}px;
    will-change: transform;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__slide {
    flex: 0 0 calc((100% - {{ block.settings.card_gap | times: 3 }}px) / 4);
    min-width: 0;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__slide:nth-child(4n + 2) { margin-top: 34px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__slide:nth-child(4n + 4) { margin-top: 58px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__card {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: {{ block.settings.card_color }};
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__media {
    height: {{ block.settings.image_height }}px;
    background: rgba(0, 0, 0, 0.06);
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__media img,
  .ai-masonry-carousel-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__placeholder { height: 100%; }
  .ai-masonry-carousel-{{ ai_gen_id }}__info { padding: 14px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__title { margin: 0 0 6px; font-size: 14px; line-height: 1.35; }
  .ai-masonry-carousel-{{ ai_gen_id }}__price { font-size: 13px; opacity: 0.78; }
  .ai-masonry-carousel-{{ ai_gen_id }}__controls { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__button {
    width: 42px;
    height: 42px;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__button:focus-visible,
  .ai-masonry-carousel-{{ ai_gen_id }}__card:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }

  @media screen and (max-width: 850px) {
    .ai-masonry-carousel-{{ ai_gen_id }}__inner { width: 100%; padding: 44px 18px; }
    .ai-masonry-carousel-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; }
    .ai-masonry-carousel-{{ ai_gen_id }}__slide { flex-basis: 100%; }
    .ai-masonry-carousel-{{ ai_gen_id }}__slide:nth-child(n) { margin-top: 0; }
    .ai-masonry-carousel-{{ ai_gen_id }}__media { height: {{ block.settings.mobile_image_height }}px; }
  }
{% endstyle %}

<infinite-masonry-carousel-{{ ai_gen_id }} class="ai-masonry-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-masonry-carousel-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-masonry-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}
    {% if block.settings.description != blank %}<p class="ai-masonry-carousel-{{ ai_gen_id }}__intro">{{ block.settings.description }}</p>{% endif %}
    {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
      <div class="ai-masonry-carousel-{{ ai_gen_id }}__viewport">
        <div class="ai-masonry-carousel-{{ ai_gen_id }}__track">
          {% for product in block.settings.collection.products limit: block.settings.product_limit %}
            <div class="ai-masonry-carousel-{{ ai_gen_id }}__slide">
              <a class="ai-masonry-carousel-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                <div class="ai-masonry-carousel-{{ ai_gen_id }}__media">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="{{ block.settings.image_height }}">
                  {% else %}
                    <div class="ai-masonry-carousel-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
                  {% endif %}
                </div>
                <div class="ai-masonry-carousel-{{ ai_gen_id }}__info"><h3 class="ai-masonry-carousel-{{ ai_gen_id }}__title">{{ product.title }}</h3><div class="ai-masonry-carousel-{{ ai_gen_id }}__price">{{ product.price | money }}</div></div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="ai-masonry-carousel-{{ ai_gen_id }}__controls">
        <button class="ai-masonry-carousel-{{ ai_gen_id }}__button" type="button" data-direction="prev" aria-label="Previous products">&#8592;</button>
        <button class="ai-masonry-carousel-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Next products">&#8594;</button>
      </div>
    {% else %}
      <div class="ai-masonry-carousel-{{ ai_gen_id }}__intro">Select a collection to display its products.</div>
    {% endif %}
  </div>
</infinite-masonry-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class InfiniteMasonryCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('.ai-masonry-carousel-{{ ai_gen_id }}__viewport');
        this.track = this.querySelector('.ai-masonry-carousel-{{ ai_gen_id }}__track');
        if (!this.track || this.track.children.length < 2) return;
        this.index = 0;
        this.busy = false;
        this.setup();
        this.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', () => this.move(button.dataset.direction === 'next' ? 1 : -1)));
        window.addEventListener('resize', () => this.setup(), { passive: true });
      }
      setup() {
        if (!this.originalSlides) {
          this.originalSlides = Array.from(this.track.children);
          this.originalCount = this.originalSlides.length;
          this.originalSlides.slice(-4).forEach((slide) => this.track.insertBefore(slide.cloneNode(true), this.track.firstChild));
          this.originalSlides.slice(0, 4).forEach((slide) => this.track.appendChild(slide.cloneNode(true)));
        }
        this.step = this.track.children[0].getBoundingClientRect().width + parseFloat(getComputedStyle(this.track).gap);
        this.index = 4;
        this.jump(false);
      }
      jump(animate) {
        this.track.style.transition = animate ? 'transform 420ms ease' : 'none';
        this.track.style.transform = 'translate3d(' + (-this.index * this.step) + 'px,0,0)';
      }
      move(direction) {
        if (this.busy) return;
        this.busy = true;
        this.index += direction;
        this.jump(true);
        this.track.addEventListener('transitionend', () => {
          if (this.index >= this.originalCount + 4) this.index = 4;
          if (this.index < 4) this.index = this.originalCount + 3;
          this.jump(false);
          requestAnimationFrame(() => { this.busy = false; });
        }, { once: true });
      }
    }
    customElements.define('infinite-masonry-carousel-{{ ai_gen_id }}', InfiniteMasonryCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Masonry product carousel",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 40, "step": 1, "default": 12 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Uneven, like real life." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Different heights. Same quality." },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "inter_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4ead8" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#fffdf6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3a2a1c" }
  ],
  "presets": [{ "name": "Masonry product carousel" }],
  "tag": null,
  "class": "masonry-product-carousel"
}
{% endschema %}