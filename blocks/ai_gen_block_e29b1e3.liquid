{% doc %}
  @prompt
    Upgrade the existing Masonry carousel block to have true infinite looping behavior using custom JavaScript. The carousel should:
    - Seamlessly loop so that when it reaches the last slide, it continues to the first slide without any jump or reset
    - When scrolling backwards from the first slide, it seamlessly goes to the last slide
    - Clone the first and last slides to create the illusion of infinite scrolling in both directions
    - No abrupt snap back to start — the transition must feel continuous and smooth in both directions
    - The infinite loop should work automatically without any user clicking a return to start button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign source_collection = block.settings.collection %}
{% assign product_count = source_collection.products.size %}

{% style %}
  .ai-masonry-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__title {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    touch-action: pan-y;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__track {
    display: flex;
    align-items: stretch;
    gap: {{ block.settings.gap }}px;
    will-change: transform;
    transition: transform {{ block.settings.transition_speed }}ms ease;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__slide {
    flex: 0 0 calc((100% - {{ block.settings.gap | times: 3 }}px) / 4);
    min-width: 0;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    text-decoration: none;
    color: inherit;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f2f2f2;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__media img,
  .ai-masonry-carousel-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 2px 2px;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__product-title,
  .ai-masonry-carousel-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__product-title {
    font-weight: 600;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__controls {
    display: flex;
    gap: 8px;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: {{ block.settings.card_background }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__button:focus-visible,
  .ai-masonry-carousel-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-masonry-carousel-{{ ai_gen_id }}__empty {
    padding: 48px 24px;
    text-align: center;
    background: #f2f2f2;
    color: #333333;
  }

  @media screen and (max-width: 989px) {
    .ai-masonry-carousel-{{ ai_gen_id }}__slide {
      flex-basis: calc((100% - {{ block.settings.gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-masonry-carousel-{{ ai_gen_id }}__header {
      align-items: start;
      flex-direction: column;
    }

    .ai-masonry-carousel-{{ ai_gen_id }}__slide {
      flex-basis: 78%;
    }
  }
{% endstyle %}

<infinite-masonry-carousel-{{ ai_gen_id }} class="ai-masonry-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or product_count > 0 %}
    <div class="ai-masonry-carousel-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}
        <h2 class="ai-masonry-carousel-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if product_count > 1 %}
        <div class="ai-masonry-carousel-{{ ai_gen_id }}__controls">
          <button class="ai-masonry-carousel-{{ ai_gen_id }}__button" type="button" data-direction="prev" aria-label="Previous products">&#8592;</button>
          <button class="ai-masonry-carousel-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Next products">&#8594;</button>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if source_collection != blank and product_count > 0 %}
    <div class="ai-masonry-carousel-{{ ai_gen_id }}__viewport" data-viewport>
      <div class="ai-masonry-carousel-{{ ai_gen_id }}__track" data-track>
        {% assign last_product = source_collection.products | last %}
        <div class="ai-masonry-carousel-{{ ai_gen_id }}__slide" data-clone="last">
          <a class="ai-masonry-carousel-{{ ai_gen_id }}__card" href="{{ last_product.url }}" tabindex="-1">
            <div class="ai-masonry-carousel-{{ ai_gen_id }}__media">{% if last_product.featured_image %}<img src="{{ last_product.featured_image | image_url: width: 900 }}" alt="{{ last_product.featured_image.alt | default: last_product.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div>
            <div class="ai-masonry-carousel-{{ ai_gen_id }}__info"><h3 class="ai-masonry-carousel-{{ ai_gen_id }}__product-title">{{ last_product.title | escape }}</h3><p class="ai-masonry-carousel-{{ ai_gen_id }}__price">{{ last_product.price | money }}</p></div>
          </a>
        </div>
        {% for product in source_collection.products limit: block.settings.product_limit %}
          <div class="ai-masonry-carousel-{{ ai_gen_id }}__slide">
            <a class="ai-masonry-carousel-{{ ai_gen_id }}__card" href="{{ product.url }}">
              <div class="ai-masonry-carousel-{{ ai_gen_id }}__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div>
              <div class="ai-masonry-carousel-{{ ai_gen_id }}__info"><h3 class="ai-masonry-carousel-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3><p class="ai-masonry-carousel-{{ ai_gen_id }}__price">{{ product.price | money }}</p></div>
            </a>
          </div>
        {% endfor %}
        {% assign first_product = source_collection.products | first %}
        <div class="ai-masonry-carousel-{{ ai_gen_id }}__slide" data-clone="first">
          <a class="ai-masonry-carousel-{{ ai_gen_id }}__card" href="{{ first_product.url }}" tabindex="-1">
            <div class="ai-masonry-carousel-{{ ai_gen_id }}__media">{% if first_product.featured_image %}<img src="{{ first_product.featured_image | image_url: width: 900 }}" alt="{{ first_product.featured_image.alt | default: first_product.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div>
            <div class="ai-masonry-carousel-{{ ai_gen_id }}__info"><h3 class="ai-masonry-carousel-{{ ai_gen_id }}__product-title">{{ first_product.title | escape }}</h3><p class="ai-masonry-carousel-{{ ai_gen_id }}__price">{{ first_product.price | money }}</p></div>
          </a>
        </div>
      </div>
    </div>
  {% else %}
    <div class="ai-masonry-carousel-{{ ai_gen_id }}__empty">Select a collection to display products.</div>
  {% endif %}
</infinite-masonry-carousel-{{ ai_gen_id }}>

<script>
  (() => {
    class InfiniteMasonryCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.viewport = this.querySelector('[data-viewport]');
        if (!this.track || !this.viewport) return;
        this.speed = {{ block.settings.transition_speed }};
        this.index = 1;
        this.dragStart = 0;
        this.dragging = false;
        this.setPosition(false);
        this.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', () => this.move(button.dataset.direction === 'next' ? 1 : -1)));
        this.track.addEventListener('transitionend', () => {
          const slides = this.track.children;
          if (this.index === slides.length - 1) {
            this.index = 1;
            this.setPosition(false);
          } else if (this.index === 0) {
            this.index = slides.length - 2;
            this.setPosition(false);
          }
        });
        this.viewport.addEventListener('pointerdown', (event) => { this.dragging = true; this.dragStart = event.clientX; this.viewport.setPointerCapture(event.pointerId); });
        this.viewport.addEventListener('pointerup', (event) => { if (!this.dragging) return; this.dragging = false; const distance = event.clientX - this.dragStart; if (Math.abs(distance) > 40) this.move(distance < 0 ? 1 : -1); });
        window.addEventListener('resize', () => this.setPosition(false));
      }
      move(direction) { this.index += direction; this.setPosition(true); }
      setPosition(animate) { this.track.style.transitionDuration = animate ? `${this.speed}ms` : '0ms'; const slide = this.track.children[0]; if (slide) this.track.style.transform = `translate3d(-${this.index * (slide.getBoundingClientRect().width + {{ block.settings.gap }})}px, 0, 0)`; }
    }
    if (!customElements.get('infinite-masonry-carousel-{{ ai_gen_id }}')) customElements.define('infinite-masonry-carousel-{{ ai_gen_id }}', InfiniteMasonryCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Infinite masonry carousel",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 2, "max": 20, "step": 1, "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 56, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "transition_speed", "label": "Transition speed", "min": 200, "max": 900, "step": 100, "unit": "ms", "default": 500 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Infinite masonry carousel" }],
  "tag": null,
  "class": "infinite-masonry-carousel-block"
}
{% endschema %}