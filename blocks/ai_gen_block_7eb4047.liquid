{% doc %}
  @prompt
    can you make this desgin but into sohpify <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>808 Store - Dynamic Diagonal</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
        <style>
            :root { --brand-brown: #8B5A2B; --brand-offwhite: #FDFBF7; --brand-charcoal: #2C2C2C; }
            body { margin: 0; font-family: 'Inter', sans-serif; background-color: var(--brand-offwhite); color: var(--brand-charcoal); }
            .hero { min-height: 100vh; display: flex; align-items: center; position: relative; overflow: hidden; }
            .diagonal-bg { position: absolute; top: 0; right: 0; width: 55%; height: 100%; background-color: var(--brand-charcoal); clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%); z-index: 1; }
            .hero-content { flex: 1; z-index: 3; padding: 0 8%; max-width: 500px; }
            .logo { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: 600; letter-spacing: 1px; margin-bottom: 2rem; }
            .logo span { font-size: 0.7rem; display: block; letter-spacing: 3px; font-family: 'Inter', sans-serif; font-weight: 400; margin-top: -5px; }
            h1 { font-family: 'Playfair Display', serif; font-size: 3.5rem; line-height: 1.1; margin-bottom: 1.5rem; }
            p { font-size: 1.1rem; line-height: 1.6; color: #666; margin-bottom: 2.5rem; }
            .btn { display: inline-block; background-color: var(--brand-charcoal); color: #fff; padding: 1rem 2.5rem; text-decoration: none; font-weight: 600; border-radius: 4px; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; }
            .btn:hover { background-color: var(--brand-brown); }
            .hero-image { flex: 1; z-index: 2; display: flex; justify-content: center; align-items: center; position: relative; }
            .hero-image img { width: 140%; max-width: 800px; transform: rotate(-20deg) translateX(-20px); filter: drop-shadow(0 40px 50px rgba(0,0,0,0.4)); }
            @media (max-width: 900px) { 
                .hero { flex-direction: column; text-align: center; padding: 4rem 5%; } 
                .diagonal-bg { width: 100%; height: 40%; top: auto; bottom: 0; clip-path: polygon(0 20%, 100% 0, 100% 100%, 0% 100%); } 
                .hero-image img { width: 100%; margin-top: 3rem; transform: rotate(-5deg); } 
            }
        </style>
    </head>
    <body>
        <section class="hero">
            <div class="diagonal-bg"></div>
