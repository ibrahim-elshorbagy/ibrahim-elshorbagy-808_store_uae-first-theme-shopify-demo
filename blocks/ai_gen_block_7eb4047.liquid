            </div>
        </section>
    </body>
    </html>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-diagonal-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__shape {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    width: 58%;
    height: 100%;
    background: {{ block.settings.accent_color }};
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    min-height: {{ block.settings.hero_height }}px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 64px 7%;
    gap: 24px;
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__content {
    max-width: 540px;
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 28px;
    font-family: {{ settings.type_subheading_font.family }}, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__heading {
    margin: 0 0 22px;
    font-family: {{ settings.type_heading_font.family }}, sans-serif;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.03;
    letter-spacing: -0.04em;
    color: {{ block.settings.heading_color }};
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__text {
    max-width: 470px;
    margin: 0 0 34px;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 32px;
    border-radius: {{ settings.button_border_radius_primary }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__button:hover,
  .ai-diagonal-hero-{{ ai_gen_id }}__button:focus-visible {
    background: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__image {
    display: block;
    width: min(125%, 760px);
    max-width: none;
    transform: rotate(-14deg) translateX(-4%);
    filter: drop-shadow(0 32px 34px rgba(0, 0, 0, 0.3));
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 620px);
    aspect-ratio: 1.25;
    color: {{ block.settings.placeholder_color }};
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }

  .ai-diagonal-hero-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 18px;
    left: 50%;
    width: 90%;
    transform: translateX(-50%);
    color: {{ block.settings.placeholder_color }};
    font-size: 13px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-diagonal-hero-{{ ai_gen_id }} {
      min-height: auto;
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__shape {
      top: auto;
      bottom: 0;
      width: 100%;
      height: 42%;
      clip-path: polygon(0 18%, 100% 0, 100% 100%, 0 100%);
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__inner {
      display: flex;
      flex-direction: column;
      min-height: auto;
      padding: 56px 24px 44px;
      text-align: center;
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__content {
      max-width: 620px;
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__eyebrow {
      margin-bottom: 22px;
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__heading {
      font-size: clamp(40px, 12vw, 60px);
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__text {
      margin-right: auto;
      margin-left: auto;
      font-size: 16px;
    }

    .ai-diagonal-hero-{{ ai_gen_id }}__image {
      width: 112%;
      transform: rotate(-7deg) translateX(-2%);
    }
  }
{% endstyle %}

<div class="ai-diagonal-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-diagonal-hero-{{ ai_gen_id }}__shape"></div>
  <div class="ai-diagonal-hero-{{ ai_gen_id }}__inner">
    <div class="ai-diagonal-hero-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-diagonal-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="ai-diagonal-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape | newline_to_br }}</h1>
      {% if block.settings.description != blank %}
        <div class="ai-diagonal-hero-{{ ai_gen_id }}__text">{{ block.settings.description }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-diagonal-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">
          {{ block.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
    <div class="ai-diagonal-hero-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img
          class="ai-diagonal-hero-{{ ai_gen_id }}__image"
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="eager"
        >
      {% else %}
        <div class="ai-diagonal-hero-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <span class="ai-diagonal-hero-{{ ai_gen_id }}__empty-state">Add a hero image to complete this design</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

