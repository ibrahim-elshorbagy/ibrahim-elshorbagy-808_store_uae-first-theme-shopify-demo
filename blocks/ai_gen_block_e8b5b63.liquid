{% doc %}
  @prompt
    Create a clean, minimal product hero section with a light cream/off-white background (#F5F3EE). Two-column layout: left side has text content, right side has a large product image.
    
    LEFT SIDE content (top to bottom):
    - Small all-caps label text: "INTRODUCING: AERO 01" (light gray, small font, letter-spacing wide)
    - Large bold headline in a heavy sans-serif font: "Made for every day." (very large, black, multi-line)
    - Subtitle text: "Lightweight comfort built for long days, daily walks, and everything in between." (gray, small, normal weight)
    - Price display: "$148" (black, medium-large, bold)
    - CTA button: "Buy Aero 01" (solid black background, white text, rounded corners, medium size)
    - Feature label in all-caps small text: "LIGHTWEIGHT / BREATHABLE" (black, letter-spacing wide)
    - Shipping info: "Free shipping · 30-day returns" (small, gray)
    - Star rating row: 5 filled stars + "4.8 · 326 reviews" (small, gray)
    
    RIGHT SIDE:
    - Large product image (uploadable via theme settings) displayed prominently, slightly angled/tilted as if floating, no background. Image should take up most of the right column.
    
    DESIGN DETAILS:
    - Background: warm cream/off-white #F5F3EF
    - Font: clean modern sans-serif (like Inter or system font)
    - No borders, no shadows on the layout
    - Plenty of whitespace, very minimal and premium feel
    - Full section padding top and bottom
    - Responsive: stack vertically on mobile (image on top, content below)
    - All text fields and the product image should be editable via theme settings schema
    - Button link should be customizable in theme settings, can you make the image we have here to move up and down ?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-aero-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};font-family:Arial,sans-serif}.ai-aero-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:8vw;min-height:620px;padding:{{ block.settings.vertical_padding }}px clamp(24px,7vw,100px)}.ai-aero-{{ ai_gen_id }}__content{max-width:520px}.ai-aero-{{ ai_gen_id }}__eyebrow,.ai-aero-{{ ai_gen_id }}__features{margin:0;font-size:11px;line-height:1.4;letter-spacing:.18em;text-transform:uppercase}.ai-aero-{{ ai_gen_id }}__eyebrow{color:{{ block.settings.muted_color }}}.ai-aero-{{ ai_gen_id }}__title{margin:22px 0 20px;font-family:{{ block.settings.heading_font.family }},Arial,sans-serif;font-size:{{ block.settings.heading_size }}px;font-weight:700;line-height:.98;letter-spacing:-.055em}.ai-aero-{{ ai_gen_id }}__description{max-width:410px;margin:0;color:{{ block.settings.muted_color }};font-size:15px;line-height:1.65}.ai-aero-{{ ai_gen_id }}__price{margin:28px 0 22px;font-size:25px;font-weight:700}.ai-aero-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;min-height:48px;padding:0 25px;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:14px;font-weight:600;text-decoration:none}.ai-aero-{{ ai_gen_id }}__button:focus-visible{outline:2px solid {{ block.settings.text_color }};outline-offset:4px}.ai-aero-{{ ai_gen_id }}__meta{margin-top:70px}.ai-aero-{{ ai_gen_id }}__shipping,.ai-aero-{{ ai_gen_id }}__rating{margin:10px 0 0;color:{{ block.settings.muted_color }};font-size:12px}.ai-aero-{{ ai_gen_id }}__rating{margin-top:6px}.ai-aero-{{ ai_gen_id }}__stars{color:{{ block.settings.star_color }};letter-spacing:.08em;margin-right:7px}.ai-aero-{{ ai_gen_id }}__media{display:flex;align-items:center;justify-content:center}.ai-aero-{{ ai_gen_id }}__media img{display:block;width:100%;max-width:680px;height:auto;transform:rotate({{ block.settings.image_angle }}deg);object-fit:contain;{% if block.settings.enable_float %}animation:ai-aero-float-{{ ai_gen_id }} {{ block.settings.float_duration }}s ease-in-out infinite alternate;{% endif %}}{% if block.settings.enable_float %}@keyframes ai-aero-float-{{ ai_gen_id }}{from{transform:rotate({{ block.settings.image_angle }}deg) translateY(-{{ block.settings.float_distance }}px)}to{transform:rotate({{ block.settings.image_angle }}deg) translateY({{ block.settings.float_distance }}px)}}{% endif %}.ai-aero-{{ ai_gen_id }}__placeholder{position:relative;width:100%;max-width:680px;aspect-ratio:1;display:flex;align-items:center;justify-content:center;color:{{ block.settings.muted_color }};text-align:center}.ai-aero-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-aero-{{ ai_gen_id }}__empty{position:absolute;font-size:13px}@media(max-width:749px){.ai-aero-{{ ai_gen_id }}__inner{display:flex;flex-direction:column;gap:32px;min-height:0;padding:40px 22px 52px}.ai-aero-{{ ai_gen_id }}__media{order:1}.ai-aero-{{ ai_gen_id }}__content{order:2;width:100%}.ai-aero-{{ ai_gen_id }}__title{font-size:min({{ block.settings.heading_size }}px,17vw)}.ai-aero-{{ ai_gen_id }}__meta{margin-top:48px}}@media(prefers-reduced-motion:reduce){.ai-aero-{{ ai_gen_id }}__media img{animation:none}}
{% endstyle %}
<section class="ai-aero-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-aero-{{ ai_gen_id }}__inner"><div class="ai-aero-{{ ai_gen_id }}__content"><p class="ai-aero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h1 class="ai-aero-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h1><p class="ai-aero-{{ ai_gen_id }}__description">{{ block.settings.description }}</p><p class="ai-aero-{{ ai_gen_id }}__price">{{ block.settings.price }}</p>{% if block.settings.button_link != blank %}<a class="ai-aero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}<div class="ai-aero-{{ ai_gen_id }}__meta"><p class="ai-aero-{{ ai_gen_id }}__features">{{ block.settings.features }}</p><p class="ai-aero-{{ ai_gen_id }}__shipping">{{ block.settings.shipping }}</p><p class="ai-aero-{{ ai_gen_id }}__rating" aria-label="{{ block.settings.rating }}"><span class="ai-aero-{{ ai_gen_id }}__stars" aria-hidden="true">★★★★★</span>{{ block.settings.rating }}</p></div></div><div class="ai-aero-{{ ai_gen_id }}__media">{% if block.settings.product_image %}<img src="{{ block.settings.product_image | image_url: width: 1400 }}" alt="{{ block.settings.product_image.alt | escape }}" loading="eager" width="{{ block.settings.product_image.width }}" height="{{ block.settings.product_image.height }}">{% else %}<div class="ai-aero-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-aero-{{ ai_gen_id }}__empty">Add a product image</span></div>{% endif %}</div></div></section>
{% schema %}{"name":"Product hero","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Label","default":"INTRODUCING: AERO 01"},{"type":"text","id":"heading","label":"Headline","default":"Made for every day."},{"type":"textarea","id":"description","label":"Subtitle","default":"Lightweight comfort built for long days, daily walks, and everything in between."},{"type":"text","id":"price","label":"Price","default":"$148"},{"type":"text","id":"button_label","label":"Button label","default":"Buy Aero 01"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"features","label":"Feature label","default":"LIGHTWEIGHT / BREATHABLE"},{"type":"text","id":"shipping","label":"Shipping info","default":"Free shipping · 30-day returns"},{"type":"text","id":"rating","label":"Rating text","default":"4.8 · 326 reviews"},{"type":"image_picker","id":"product_image","label":"Product image"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":40,"max":160,"step":10,"unit":"px","default":90},{"type":"range","id":"heading_size","label":"Headline size","min":40,"max":100,"step":5,"unit":"px","default":70},{"type":"range","id":"image_angle","label":"Image angle","min":-8,"max":8,"step":1,"unit":"deg","default":-3},{"type":"font_picker","id":"heading_font","label":"Headline font","default":"inter_n7"},{"type":"header","content":"Image movement"},{"type":"checkbox","id":"enable_float","label":"Enable vertical movement","default":true},{"type":"range","id":"float_distance","label":"Movement distance","min":2,"max":30,"step":2,"unit":"px","default":10},{"type":"range","id":"float_duration","label":"Movement speed","min":2,"max":12,"step":1,"unit":"s","default":6},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#F5F3EE"},{"type":"color","id":"text_color","label":"Text","default":"#111111"},{"type":"color","id":"muted_color","label":"Muted text","default":"#66645F"},{"type":"color","id":"button_color","label":"Button","default":"#111111"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"color","id":"star_color","label":"Stars","default":"#111111"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":8}],"presets":[{"name":"Product hero"}],"tag":null,"class":"product-hero-block"}{% endschema %}