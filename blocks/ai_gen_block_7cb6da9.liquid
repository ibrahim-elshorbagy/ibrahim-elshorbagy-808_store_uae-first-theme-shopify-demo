{% doc %}
  @prompt
    Create a premium announcement bar for a luxury men's footwear store in UAE. It should rotate between 3 messages with a smooth fade transition every 4 seconds: 1. "Free Shipping on Orders Above AED 300" 2. "New Collection Has Arrived — Shop Now" 3. "Easy Returns Within 14 Days". Background color: #1a1a1a (near black). Text color: #c9a96e (gold). Font: Inter, uppercase, letter-spacing 2px, font-size 13px. Center aligned. Height 40px. Include a close/dismiss button on the right side. Auto-rotate with CSS animation or JavaScript. No library dependencies., make it's width wider not max width , widerrrrrrrrr no max width !!!!
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    position: relative;
    left: 50%;
    width: max(100vw, {{ block.settings.desktop_width_percent }}%);
    transform: translateX(-50%);
    height: 40px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.announcement_font.family }}, {{ block.settings.announcement_font.fallback_families }};
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 2px;
    line-height: 40px;
    text-transform: uppercase;
    text-align: center;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__message {
    position: absolute;
    inset: 0 48px 0 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.45s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__message.is-fading {
    opacity: 0;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__close {
    position: absolute;
    top: 0;
    right: 12px;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__close:hover,
  .ai-announcement-bar-{{ ai_gen_id }}__close:focus-visible {
    opacity: 0.75;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__close:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: -4px;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__close svg {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }}__message {
      inset: 0 44px 0 12px;
      font-size: 11px;
      letter-spacing: 1.4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-announcement-bar-{{ ai_gen_id }}__message {
      transition: none;
    }
  }
{% endstyle %}

<luxury-announcement-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-dismiss-key="ai-announcement-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar-{{ ai_gen_id }}__message" role="status" aria-live="polite">{{ block.settings.message_one | escape }}</div>
  <button type="button" class="ai-announcement-bar-{{ ai_gen_id }}__close" aria-label="Dismiss announcement">
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 3L13 13M13 3L3 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </button>
</luxury-announcement-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryAnnouncement{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.message = this.querySelector('.ai-announcement-bar-{{ ai_gen_id }}__message');
        this.closeButton = this.querySelector('.ai-announcement-bar-{{ ai_gen_id }}__close');
        this.messages = [{{ block.settings.message_one | json }}, {{ block.settings.message_two | json }}, {{ block.settings.message_three | json }}];
        this.index = 0;
        this.timer = null;

        if (window.localStorage && localStorage.getItem(this.dataset.dismissKey) === 'true') {
          this.remove();
          return;
        }

        this.closeButton.addEventListener('click', () => this.dismiss());
        this.timer = window.setInterval(() => {
          this.message.classList.add('is-fading');
          window.setTimeout(() => {
            this.index = (this.index + 1) % this.messages.length;
            this.message.textContent = this.messages[this.index];
            this.message.classList.remove('is-fading');
          }, 450);
        }, 4000);
      }

      dismiss() {
        if (this.timer) window.clearInterval(this.timer);
        if (window.localStorage) localStorage.setItem(this.dataset.dismissKey, 'true');
        this.remove();
      }
    }

    if (!customElements.get('luxury-announcement-{{ ai_gen_id }}')) {
      customElements.define('luxury-announcement-{{ ai_gen_id }}', LuxuryAnnouncement{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Luxury announcement bar",
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "message_one",
      "label": "Message one",
      "default": "Free Shipping on Orders Above AED 300"
    },
    {
      "type": "text",
      "id": "message_two",
      "label": "Message two",
      "default": "New Collection Has Arrived — Shop Now"
    },
    {
      "type": "text",
      "id": "message_three",
      "label": "Message three",
      "default": "Easy Returns Within 14 Days"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "announcement_font",
      "label": "Font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#c9a96e"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [{"name": "Luxury announcement bar"}],
  "tag": null,
  "class": "luxury-announcement-block"
}
{% endschema %}