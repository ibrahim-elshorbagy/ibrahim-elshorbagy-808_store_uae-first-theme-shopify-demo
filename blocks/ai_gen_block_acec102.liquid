{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-masonry-{{ ai_gen_id }}{display:block;position:relative;width:100%;padding:{{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};isolation:isolate}
  .ai-masonry-{{ ai_gen_id }}:before{content:'';position:absolute;z-index:-1;inset:0 auto 0 50%;width:100vw;transform:translateX(-50%);background:{{ block.settings.background_color }}}
  .ai-masonry__inner-{{ ai_gen_id }}{width:{{ block.settings.desktop_width_percent }}%;max-width:1440px;margin:0 auto;padding:0 24px}
  .ai-masonry__header-{{ ai_gen_id }}{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}
  .ai-masonry__title-{{ ai_gen_id }}{margin:0;font-family:{{ block.settings.heading_font.family }};font-weight:{{ block.settings.heading_font.weight }};font-size:{{ block.settings.heading_size }}px;line-height:1.05}
  .ai-masonry__desc-{{ ai_gen_id }}{margin:10px 0 0;font-size:15px;opacity:.8}
  .ai-masonry__controls-{{ ai_gen_id }}{display:flex;gap:8px;flex-shrink:0}
  .ai-masonry__button-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border:1px solid {{ block.settings.text_color }};border-radius:50%;background:transparent;color:{{ block.settings.text_color }};cursor:pointer}
  .ai-masonry__button-{{ ai_gen_id }}:disabled{opacity:.35;cursor:not-allowed}.ai-masonry__button-{{ ai_gen_id }}:focus-visible{outline:3px solid {{ block.settings.text_color }};outline-offset:3px}
  .ai-masonry__viewport-{{ ai_gen_id }}{overflow:hidden}.ai-masonry__track-{{ ai_gen_id }}{display:flex;align-items:flex-start;gap:{{ block.settings.card_gap }}px;transition:transform .35s ease;will-change:transform}
  .ai-masonry__card-{{ ai_gen_id }}{flex:0 0 calc((100% - ({{ block.settings.card_gap }}px * 3))/4);min-width:0;overflow:hidden;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};box-shadow:0 14px 32px rgba(0,0,0,.1)}
  .ai-masonry__card-{{ ai_gen_id }}:nth-child(4n+2){margin-top:30px}.ai-masonry__card-{{ ai_gen_id }}:nth-child(4n+3){margin-top:58px}.ai-masonry__card-{{ ai_gen_id }}:nth-child(4n+4){margin-top:18px}.ai-masonry__card-{{ ai_gen_id }}:nth-child(8n+5){margin-top:-18px}.ai-masonry__card-{{ ai_gen_id }}:nth-child(8n+6){margin-top:44px}.ai-masonry__card-{{ ai_gen_id }}:nth-child(8n+7){margin-top:8px}.ai-masonry__card-{{ ai_gen_id }}:nth-child(8n){margin-top:68px}
  .ai-masonry__media-{{ ai_gen_id }}{display:block;height:280px;background:#e8e8e8}.ai-masonry__media-{{ ai_gen_id }} img{display:block;width:100%;height:100%;object-fit:cover}.ai-masonry__placeholder-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:center;height:100%}.ai-masonry__placeholder-{{ ai_gen_id }} svg{width:100%;height:100%}.ai-masonry__info-{{ ai_gen_id }}{padding:14px}.ai-masonry__name-{{ ai_gen_id }}{display:block;margin:0 0 6px;color:{{ block.settings.text_color }};font-size:14px;font-weight:600;text-decoration:none}.ai-masonry__price-{{ ai_gen_id }}{font-size:13px}
  @media(max-width:749px){.ai-masonry__inner-{{ ai_gen_id }}{width:100%;padding:0 16px}.ai-masonry__header-{{ ai_gen_id }}{align-items:start}.ai-masonry__title-{{ ai_gen_id }}{font-size:{{ block.settings.mobile_heading_size }}px}.ai-masonry__card-{{ ai_gen_id }}{flex-basis:100%}.ai-masonry__card-{{ ai_gen_id }}:nth-child(n){margin-top:0}.ai-masonry__media-{{ ai_gen_id }}{height:360px}}
{% endstyle %}
<collection-masonry-{{ ai_gen_id }} class="ai-masonry-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-masonry__inner-{{ ai_gen_id }}">
    <div class="ai-masonry__header-{{ ai_gen_id }}"><div>{% if block.settings.heading != blank %}<h2 class="ai-masonry__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.description != blank %}<p class="ai-masonry__desc-{{ ai_gen_id }}">{{ block.settings.description }}</p>{% endif %}</div>{% if block.settings.collection != blank and block.settings.collection.products_count > 4 %}<div class="ai-masonry__controls-{{ ai_gen_id }}"><button class="ai-masonry__button-{{ ai_gen_id }}" type="button" data-prev aria-label="Previous products">←</button><button class="ai-masonry__button-{{ ai_gen_id }}" type="button" data-next aria-label="Next products">→</button></div>{% endif %}</div>
    {% if block.settings.collection != blank %}<div class="ai-masonry__viewport-{{ ai_gen_id }}" data-viewport><div class="ai-masonry__track-{{ ai_gen_id }}" data-track>{% for product in block.settings.collection.products %}<article class="ai-masonry__card-{{ ai_gen_id }}"><a class="ai-masonry__media-{{ ai_gen_id }}" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">{% else %}<div class="ai-masonry__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a><div class="ai-masonry__info-{{ ai_gen_id }}"><a class="ai-masonry__name-{{ ai_gen_id }}" href="{{ product.url }}">{{ product.title }}</a><div class="ai-masonry__price-{{ ai_gen_id }}">{{ product.price | money }}</div></div></article>{% endfor %}</div></div>{% else %}<p class="ai-masonry__desc-{{ ai_gen_id }}">Select a collection to display its products.</p>{% endif %}
  </div>
</collection-masonry-{{ ai_gen_id }}>
<script>(function(){class CollectionMasonry{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[data-track]');this.viewport=this.querySelector('[data-viewport]');this.prev=this.querySelector('[data-prev]');this.next=this.querySelector('[data-next]');if(!this.track)return;this.index=0;this.update=this.update.bind(this);this.prev&&this.prev.addEventListener('click',()=>{this.index=Math.max(0,this.index-1);this.update()});this.next&&this.next.addEventListener('click',()=>{this.index=Math.min(this.maxIndex(),this.index+1);this.update()});window.addEventListener('resize',this.update);this.update()}maxIndex(){return Math.max(0,this.track.children.length-(window.innerWidth<=749?1:4))}update(){let card=this.track.children[0];if(!card)return;let distance=card.getBoundingClientRect().width+parseFloat(getComputedStyle(this.track).gap);this.index=Math.min(this.index,this.maxIndex());this.track.style.transform='translateX(-'+distance*this.index+'px)';if(this.prev)this.prev.disabled=this.index===0;if(this.next)this.next.disabled=this.index>=this.maxIndex()}}customElements.define('collection-masonry-{{ ai_gen_id }}',CollectionMasonry{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Masonry carousel","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Heading","default":"Uneven, like real life."},{"type":"textarea","id":"description","label":"Description","default":"Different heights. Same quality."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"sans-serif"},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":48,"step":4,"unit":"px","default":32},{"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":18},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":8,"unit":"px","default":64},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":8,"unit":"px","default":64},{"type":"color","id":"background_color","label":"Background","default":"#f4ead8"},{"type":"color","id":"text_color","label":"Text","default":"#3a2a1c"},{"type":"color","id":"card_background","label":"Card background","default":"#fffdf6"}],"presets":[{"name":"Masonry carousel"}],"tag":null,"class":"masonry-carousel"}{% endschema %}