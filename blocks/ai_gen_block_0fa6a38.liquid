{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-collection-carousel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};overflow:hidden}.ai-collection-carousel__inner-{{ ai_gen_id }}{padding:{{ block.settings.section_padding }}px 24px}.ai-collection-carousel__header-{{ ai_gen_id }},.ai-collection-carousel__viewport-{{ ai_gen_id }}{max-width:1160px;margin:0 auto}.ai-collection-carousel__header-{{ ai_gen_id }}{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.ai-collection-carousel__title-{{ ai_gen_id }}{margin:0;font-size:{{ block.settings.heading_size }}px;line-height:1.05}.ai-collection-carousel__description-{{ ai_gen_id }}{margin:8px 0 0;opacity:.78;font-size:15px}.ai-collection-carousel__controls-{{ ai_gen_id }}{display:flex;gap:8px}.ai-collection-carousel__button-{{ ai_gen_id }}{width:42px;height:42px;border:1px solid currentColor;border-radius:50%;background:transparent;color:inherit;cursor:pointer;font-size:20px}.ai-collection-carousel__button-{{ ai_gen_id }}:focus-visible,.ai-collection-carousel__card-{{ ai_gen_id }}:focus-visible{outline:3px solid currentColor;outline-offset:3px}.ai-collection-carousel__viewport-{{ ai_gen_id }}{overflow:hidden}.ai-collection-carousel__track-{{ ai_gen_id }}{display:flex;gap:18px;align-items:flex-start;transition:transform .35s ease}.ai-collection-carousel__card-{{ ai_gen_id }}{flex:0 0 calc((100% - 54px)/4);background:{{ block.settings.card_color }};border-radius:{{ block.settings.card_radius }}px;overflow:hidden;color:inherit;text-decoration:none;box-shadow:0 16px 40px rgba(0,0,0,.12)}.ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(4n+2){margin-top:34px}.ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(4n+3){margin-top:10px}.ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(4n){margin-top:52px}.ai-collection-carousel__image-{{ ai_gen_id }}{height:{{ block.settings.image_height }}px;background:rgba(0,0,0,.05)}.ai-collection-carousel__image-{{ ai_gen_id }} img,.ai-collection-carousel__placeholder-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;object-fit:cover}.ai-collection-carousel__placeholder-{{ ai_gen_id }}{height:100%;opacity:.35}.ai-collection-carousel__info-{{ ai_gen_id }}{padding:14px}.ai-collection-carousel__product-title-{{ ai_gen_id }}{margin:0 0 6px;font-size:14px;line-height:1.3}.ai-collection-carousel__price-{{ ai_gen_id }}{font-size:14px;font-weight:600}@media(max-width:749px){.ai-collection-carousel__inner-{{ ai_gen_id }}{padding:42px 16px}.ai-collection-carousel__title-{{ ai_gen_id }}{font-size:{{ block.settings.mobile_heading_size }}px}.ai-collection-carousel__card-{{ ai_gen_id }}{flex-basis:100%}.ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(n){margin-top:0}.ai-collection-carousel__image-{{ ai_gen_id }}{height:{{ block.settings.mobile_image_height }}px}}
{% endstyle %}
<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-collection-carousel__inner-{{ ai_gen_id }}"><div class="ai-collection-carousel__header-{{ ai_gen_id }}"><div>{% if block.settings.heading != blank %}<h2 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<p class="ai-collection-carousel__description-{{ ai_gen_id }}">{{ block.settings.description | escape }}</p>{% endif %}</div><div class="ai-collection-carousel__controls-{{ ai_gen_id }}"><button type="button" class="ai-collection-carousel__button-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous products">&#8592;</button><button type="button" class="ai-collection-carousel__button-{{ ai_gen_id }}" data-direction="next" aria-label="Next products">&#8594;</button></div></div>{% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}<div class="ai-collection-carousel__viewport-{{ ai_gen_id }}"><div class="ai-collection-carousel__track-{{ ai_gen_id }}" data-track>{% for product in block.settings.collection.products limit: 24 %}<a href="{{ product.url }}" class="ai-collection-carousel__card-{{ ai_gen_id }}"><div class="ai-collection-carousel__image-{{ ai_gen_id }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">{% else %}<div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-collection-carousel__info-{{ ai_gen_id }}"><h3 class="ai-collection-carousel__product-title-{{ ai_gen_id }}">{{ product.title | escape }}</h3><div class="ai-collection-carousel__price-{{ ai_gen_id }}">{{ product.price | money }}</div></div></a>{% endfor %}</div></div>{% else %}<p class="ai-collection-carousel__description-{{ ai_gen_id }}">Select a collection to display its products.</p>{% endif %}</div></collection-carousel-{{ ai_gen_id }}>
<script>(function(){class CollectionCarousel{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[data-track]');if(!this.track)return;this.cards=[...this.track.children];this.index=0;this.querySelectorAll('[data-direction]').forEach(b=>b.addEventListener('click',()=>this.move(b.dataset.direction)));window.addEventListener('resize',()=>this.update());this.update()}move(d){let v=matchMedia('(max-width:749px)').matches?1:4,m=Math.max(0,this.cards.length-v);if(d==='next')this.index=this.index>=m?0:this.index+1;if(d==='prev')this.index=this.index<=0?m:this.index-1;this.update()}update(){if(this.cards.length)this.track.style.transform='translateX(-'+this.index*(this.cards[0].getBoundingClientRect().width+18)+'px)'}}customElements.define('collection-carousel-{{ ai_gen_id }}',CollectionCarousel{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Collection carousel","settings":[{"type":"header","content":"Collection"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Heading","default":"Uneven, like real life."},{"type":"textarea","id":"description","label":"Description","default":"Different heights. Same quality."},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Section padding","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"image_height","label":"Image height","min":160,"max":420,"step":10,"unit":"px","default":280},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":180,"max":500,"step":10,"unit":"px","default":320},{"type":"header","content":"Style"},{"type":"color","id":"background_color","label":"Background","default":"#F4EAD8"},{"type":"color","id":"card_color","label":"Card background","default":"#FFFDF6"},{"type":"color","id":"text_color","label":"Text","default":"#3A2A1C"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":18},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":72,"step":2,"unit":"px","default":52},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":24,"max":48,"step":2,"unit":"px","default":34}],"presets":[{"name":"Collection carousel"}],"tag":null,"class":"collection-carousel"}{% endschema %}