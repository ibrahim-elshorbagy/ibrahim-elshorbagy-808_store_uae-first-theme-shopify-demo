{% doc %}
  @prompt
    build this about Brand section
    Add a button below the heading.
    make bg color stretched, make bg stretched take full width of the page
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}




{% style %}
  .ai-about-brand-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};

    /* Stretch background beyond the section without 100vw */
    box-shadow: 0 0 0 100vmax {{ block.settings.background_color }};
    clip-path: inset(0 -100vmax);
  }

  .ai-about-brand-{{ ai_gen_id }} *,
  .ai-about-brand-{{ ai_gen_id }} *::before,
  .ai-about-brand-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  .ai-about-brand-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1100px;
    min-height: {{ block.settings.section_height }}px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    align-items: stretch;
  }

  .ai-about-brand-{{ ai_gen_id }}__copy {
    min-width: 0;
    padding: 64px 50px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .ai-about-brand-{{ ai_gen_id }}__logo,
  .ai-about-brand-{{ ai_gen_id }}__logo-placeholder {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .ai-about-brand-{{ ai_gen_id }}__logo {
    display: block;
    object-fit: cover;
  }

  .ai-about-brand-{{ ai_gen_id }}__logo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-about-brand-{{ ai_gen_id }}__logo-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-about-brand-{{ ai_gen_id }}__heading {
    width: 100%;
    max-width: 620px;
    margin: 16px 0;

    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -.03em;
    overflow-wrap: anywhere;
  }

  .ai-about-brand-{{ ai_gen_id }}__accent {
    color: {{ block.settings.accent_color }};
  }

  .ai-about-brand-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: fit-content;
    max-width: 100%;
    margin: 8px 0 24px;
    padding: 14px 28px;

    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};

    text-decoration: none;
    font-family: {{ block.settings.body_font.family }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;

    border-radius: {{ block.settings.button_radius }}px;
    transition: opacity .2s ease, transform .2s ease;
  }

  .ai-about-brand-{{ ai_gen_id }}__button:hover {
    opacity: .85;
    transform: translateY(-2px);
  }

  .ai-about-brand-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  .ai-about-brand-{{ ai_gen_id }}__description {
    width: 100%;
    max-width: 560px;
    margin: 0;

    color: {{ block.settings.muted_text_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .ai-about-brand-{{ ai_gen_id }}__photo {
    position: relative;
    min-width: 0;
    min-height: {{ block.settings.section_height }}px;
    background: {{ block.settings.image_background_color }};
    overflow: hidden;
  }

  .ai-about-brand-{{ ai_gen_id }}__photo img,
  .ai-about-brand-{{ ai_gen_id }}__photo-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.section_height }}px;
  }

  .ai-about-brand-{{ ai_gen_id }}__photo img {
    object-fit: cover;
  }

  .ai-about-brand-{{ ai_gen_id }}__photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-about-brand-{{ ai_gen_id }}__photo-placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 800px) {
    .ai-about-brand-{{ ai_gen_id }}__inner {
      width: 100%;
      max-width: 100%;
      grid-template-columns: minmax(0, 1fr);
    }

    .ai-about-brand-{{ ai_gen_id }}__copy {
      padding: 48px 24px;
    }

    .ai-about-brand-{{ ai_gen_id }}__heading {
      font-size: clamp(32px, 8vw, 46px);
    }

    .ai-about-brand-{{ ai_gen_id }}__photo,
    .ai-about-brand-{{ ai_gen_id }}__photo img,
    .ai-about-brand-{{ ai_gen_id }}__photo-placeholder {
      min-height: 60vh;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-about-brand-{{ ai_gen_id }}__copy {
      padding: 40px 20px;
    }

    .ai-about-brand-{{ ai_gen_id }}__button {
      padding: 13px 22px;
    }
  }
{% endstyle %}
<section class="ai-about-brand-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-about-brand-{{ ai_gen_id }}__inner">
    <div class="ai-about-brand-{{ ai_gen_id }}__copy">
      {% if block.settings.logo %}
        <img
          class="ai-about-brand-{{ ai_gen_id }}__logo"
          src="{{ block.settings.logo | image_url: width:160 }}"
          alt="{{ block.settings.logo.alt | default: block.settings.brand_name | escape }}"
          width="62"
          height="62"
          loading="lazy"
        >
      {% else %}
        <div class="ai-about-brand-{{ ai_gen_id }}__logo-placeholder" aria-hidden="true">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <h2 class="ai-about-brand-{{ ai_gen_id }}__heading">
        {{ block.settings.heading_before }}
        <span class="ai-about-brand-{{ ai_gen_id }}__accent">
          {{ block.settings.heading_accent }}
        </span>
      </h2>

      {% if block.settings.description != blank %}
        <p class="ai-about-brand-{{ ai_gen_id }}__description">
          {{ block.settings.description }}
        </p>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          class="ai-about-brand-{{ ai_gen_id }}__button"
          href="{{ block.settings.button_link }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-about-brand-{{ ai_gen_id }}__photo">
      {% if block.settings.photo %}
        <img
          src="{{ block.settings.photo | image_url: width:1200 }}"
          alt="{{ block.settings.photo.alt | default: block.settings.photo_alt | escape }}"
          width="{{ block.settings.photo.width }}"
          height="{{ block.settings.photo.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-about-brand-{{ ai_gen_id }}__photo-placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About brand split",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "808 Store UAE"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading first part",
      "default": "BUILT TO"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "FLOAT."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "808 Store UAE — men's grey sneakers with a white ridged sole. Light for metro days, sharp for nights. Premium styles, everyday class."
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Brand photo"
    },
    {
      "type": "text",
      "id": "photo_alt",
      "label": "Photo alt text",
      "default": "Grey sneakers floating"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 420,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#C6FF00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#B8B8B8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#C6FF00"
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Image background",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "inter_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    }
  ],
  "presets": [
    {
      "name": "About brand split"
    }
  ],
  "tag": null,
  "class": "about-brand-split-block"
}
{% endschema %}
