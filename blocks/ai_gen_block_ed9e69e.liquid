{% doc %}
  @prompt
    Create a contact form section that matches this exact design: Two-column layout - left side has a product lifestyle photo (use a placeholder image) with an overlay at the bottom showing "808 Store · UAE" and "WhatsApp · Instagram @808_store_uae" in white text. Right side has heading "Ask about your pair." in Fraunces serif font (48px, weight 600), subtitle "Fit, stock, delivery — send it here." in gray. Form below with 2-column grid layout: Name input, Mobile/phone input (side by side), then full-width Topic dropdown with options: Sizing help, My order, Exchange or return, Something else. Then full-width Message textarea (min-height 100px). Then full-width submit button "Send message →" with dark background #1c1a16 and white text. Input styles: border 1px solid #ddd6c6, border-radius 10px, padding 13px, font Work Sans 14px. Left photo column: background #e7ddc8, border-radius 22px, min-height 560px. Overall max-width 1180px, padding 72px 28px. Use Shopify native contact form tag (form 'contact') so it actually works and sends to store email. Allow merchant to pick the photo from theme settings. Responsive: stack to single column on mobile, photo min-height 340px on mobile. learn from this <!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact 04 — Photo Side</title><link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet"><style>*{margin:0;box-sizing:border-box}body{font-family:"Work Sans",sans-serif;background:#fff;color:#1c1a16}.s{max-width:1180px;margin:0 auto;padding:72px 28px;display:grid;grid-template-columns:380px 1fr;gap:36px;align-items:stretch}.ph{background:#e7ddc8;border-radius:22px;overflow:hidden;min-height:560px;position:relative}.ph img{width:100%;height:100%;min-height:560px;object-fit:cover;display:block}.ph div{position:absolute;bottom:0;left:0;right:0;padding:24px;background:linear-gradient(transparent,rgba(0,0,0,.7));color:#fff}.box h2{font-family:Fraunces,serif;font-size:clamp(32px,4vw,48px);font-weight:600}form{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px}form .full{grid-column:1/-1}input,select,textarea{border:1px solid #ddd6c6;border-radius:10px;padding:13px;font-family:inherit;font-size:14px;width:100%}textarea{min-height:100px;resize:vertical}button{grid-column:1/-1;background:#1c1a16;color:#fff;border:0;border-radius:10px;padding:15px;font-weight:600;cursor:pointer}@media(max-width:850px){.s{grid-template-columns:1fr}.ph,.ph img{min-height:340px}}</style></head><body><section class="s"><div class="ph"><img src="../navy-blue-suede-loafer-interior.jpg" alt="Navy loafers styled at home" onerror="this.remove()"><div><b>808 Store · UAE</b><br><small>WhatsApp · Instagram @808_store_uae</small></div></div><div class="box"><h2>Ask about your pair.</h2><p style="color:#666;font-size:14px">Fit, stock, delivery — send it here.</p><form action="#" method="post"><input type="text" name="name" placeholder="Name"><input type="tel" name="phone" placeholder="Mobile"><select name="topic" class="full"><option>Sizing help</option><option>My order</option><option>Exchange or return</option><option>Something else</option></select><textarea name="message" class="full" placeholder="Message…"></textarea><button type="submit">Send message →</button></form></div></section></body></html>
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture form_class %}ai-contact-{{ ai_gen_id }}__form{% endcapture %}

{% style %}
  .ai-contact-{{ ai_gen_id }} { display:block; width:100%; background:{{ block.settings.background_color }}; }
  .ai-contact-{{ ai_gen_id }}__inner { width:{{ block.settings.desktop_width_percent }}%; max-width:1180px; margin:0 auto; padding:72px 28px; display:grid; grid-template-columns:380px minmax(0,1fr); gap:36px; align-items:stretch; }
  .ai-contact-{{ ai_gen_id }}__photo { position:relative; min-height:560px; overflow:hidden; border-radius:22px; background:#e7ddc8; }
  .ai-contact-{{ ai_gen_id }}__photo img,.ai-contact-{{ ai_gen_id }}__photo-placeholder svg { display:block; width:100%; height:100%; min-height:560px; object-fit:cover; }
  .ai-contact-{{ ai_gen_id }}__photo-placeholder { min-height:560px; color:#716956; }
  .ai-contact-{{ ai_gen_id }}__overlay { position:absolute; right:0; bottom:0; left:0; padding:56px 24px 24px; color:#fff; background:linear-gradient(transparent,rgba(28,26,22,.78)); }
  .ai-contact-{{ ai_gen_id }}__overlay strong,.ai-contact-{{ ai_gen_id }}__overlay span { display:block; }
  .ai-contact-{{ ai_gen_id }}__overlay strong { margin-bottom:4px; font-size:15px; font-weight:600; }
  .ai-contact-{{ ai_gen_id }}__overlay span { font-size:13px; }
  .ai-contact-{{ ai_gen_id }}__content { align-self:center; }
  .ai-contact-{{ ai_gen_id }}__heading { margin:0; color:{{ block.settings.heading_color }}; font-family:"Fraunces",Georgia,serif; font-size:48px; font-weight:600; line-height:1.08; letter-spacing:-.03em; }
  .ai-contact-{{ ai_gen_id }}__subtitle { margin:12px 0 0; color:#666; font-family:{{ block.settings.body_font.family }}; font-size:14px; line-height:1.5; }
  .ai-contact-{{ ai_gen_id }}__form { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:22px; }
  .ai-contact-{{ ai_gen_id }}__field,.ai-contact-{{ ai_gen_id }}__button,.ai-contact-{{ ai_gen_id }}__message { grid-column:1/-1; }
  .ai-contact-{{ ai_gen_id }}__form input,.ai-contact-{{ ai_gen_id }}__form select,.ai-contact-{{ ai_gen_id }}__form textarea { width:100%; box-sizing:border-box; border:1px solid #ddd6c6; border-radius:10px; padding:13px; color:#1c1a16; background:#fff; font-family:{{ block.settings.body_font.family }}; font-size:14px; line-height:1.4; }
  .ai-contact-{{ ai_gen_id }}__form input:focus,.ai-contact-{{ ai_gen_id }}__form select:focus,.ai-contact-{{ ai_gen_id }}__form textarea:focus { outline:2px solid #1c1a16; outline-offset:2px; }
  .ai-contact-{{ ai_gen_id }}__form textarea { min-height:100px; resize:vertical; }
  .ai-contact-{{ ai_gen_id }}__button { border:0; border-radius:10px; padding:15px; color:#fff; background:#1c1a16; font-family:{{ block.settings.body_font.family }}; font-size:14px; font-weight:600; cursor:pointer; }
  .ai-contact-{{ ai_gen_id }}__button:hover { background:#33302a; }
  .ai-contact-{{ ai_gen_id }}__message { margin:0; color:#1c1a16; font-family:{{ block.settings.body_font.family }}; font-size:14px; }
  @media screen and (max-width:850px) { .ai-contact-{{ ai_gen_id }}__inner { grid-template-columns:1fr; padding:48px 20px; } .ai-contact-{{ ai_gen_id }}__photo,.ai-contact-{{ ai_gen_id }}__photo-placeholder,.ai-contact-{{ ai_gen_id }}__photo img,.ai-contact-{{ ai_gen_id }}__photo-placeholder svg { min-height:340px; } }
  @media screen and (max-width:520px) { .ai-contact-{{ ai_gen_id }}__form { grid-template-columns:1fr; } .ai-contact-{{ ai_gen_id }}__heading { font-size:40px; } }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-{{ ai_gen_id }}__inner">
    <div class="ai-contact-{{ ai_gen_id }}__photo">
      {% if block.settings.photo != blank %}<img src="{{ block.settings.photo | image_url: width: 900 }}" alt="{{ block.settings.photo.alt | escape }}" loading="lazy" width="{{ block.settings.photo.width }}" height="{{ block.settings.photo.height }}">{% else %}<div class="ai-contact-{{ ai_gen_id }}__photo-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
      <div class="ai-contact-{{ ai_gen_id }}__overlay"><strong>808 Store · UAE</strong><span>WhatsApp · Instagram @808_store_uae</span></div>
    </div>
    <div class="ai-contact-{{ ai_gen_id }}__content">
      <h2 class="ai-contact-{{ ai_gen_id }}__heading">Ask about your pair.</h2>
      <p class="ai-contact-{{ ai_gen_id }}__subtitle">Fit, stock, delivery — send it here.</p>
      {% form 'contact', class: form_class %}
        {% if form.posted_successfully? %}<p class="ai-contact-{{ ai_gen_id }}__message" tabindex="-1">Thanks — your message has been sent.</p>{% elsif form.errors %}<p class="ai-contact-{{ ai_gen_id }}__message" tabindex="-1">Please check the form and try again.</p>{% endif %}
        <input type="text" name="contact[name]" placeholder="Name" aria-label="Name" autocomplete="name" required>
        <input type="tel" name="contact[phone]" placeholder="Mobile / phone" aria-label="Mobile / phone" autocomplete="tel" required>
        <div class="ai-contact-{{ ai_gen_id }}__field"><select name="contact[topic]" aria-label="Topic" required><option value="" disabled selected>Topic</option><option value="Sizing help">Sizing help</option><option value="My order">My order</option><option value="Exchange or return">Exchange or return</option><option value="Something else">Something else</option></select></div>
        <div class="ai-contact-{{ ai_gen_id }}__field"><textarea name="contact[body]" placeholder="Message…" aria-label="Message" required></textarea></div>
        <button class="ai-contact-{{ ai_gen_id }}__button" type="submit">Send message →</button>
      {% endform %}
    </div>
  </div>
</contact-form-{{ ai_gen_id }}>

<script>(function(){if(!customElements.get('contact-form-{{ ai_gen_id }}')){customElements.define('contact-form-{{ ai_gen_id }}',class extends HTMLElement{connectedCallback(){const message=this.querySelector('.ai-contact-{{ ai_gen_id }}__message');if(message)message.focus();}});}})();</script>

{% schema %}
{"name":"Premium contact form","settings":[{"type":"image_picker","id":"photo","label":"Lifestyle photo"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"body_font","label":"Body font","default":"work_sans_n4"},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading","default":"#1c1a16"}],"presets":[{"name":"Premium contact form"}],"tag":null,"class":"premium-contact-form"}
{% endschema %}