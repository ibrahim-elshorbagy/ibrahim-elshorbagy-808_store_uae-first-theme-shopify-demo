{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% style %}
  .ai-luxury-product-{{ ai_gen_id }} { display:block; width:100%; background:#F5F2EE; color:#2C2C2C; }
  .ai-luxury-product-{{ ai_gen_id }}__inner { width:{{ block.settings.desktop_width_percent }}%; max-width:1400px; margin:0 auto; padding:60px; display:grid; grid-template-columns:55fr 45fr; gap:56px; box-sizing:border-box; }
  .ai-luxury-product-{{ ai_gen_id }}__gallery { position:sticky; top:24px; align-self:start; }
  .ai-luxury-product-{{ ai_gen_id }}__main { aspect-ratio:4 / 5; overflow:hidden; border-radius:4px; background:transparent; }
  .ai-luxury-product-{{ ai_gen_id }}__main img { width:100%; height:100%; display:block; object-fit:cover; }
  .ai-luxury-product-{{ ai_gen_id }}__placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:transparent; }
  .ai-luxury-product-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; }
  .ai-luxury-product-{{ ai_gen_id }}__thumbs { display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__thumb { width:72px; height:90px; padding:0; border:1px solid transparent; border-radius:4px; overflow:hidden; background:transparent; cursor:pointer; }
  .ai-luxury-product-{{ ai_gen_id }}__thumb[aria-current="true"] { border-color:#C9A84C; }
  .ai-luxury-product-{{ ai_gen_id }}__thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .ai-luxury-product-{{ ai_gen_id }}__vendor { margin:0 0 14px; color:#8A6D24; font-size:11px; letter-spacing:.16em; text-transform:uppercase; }
  .ai-luxury-product-{{ ai_gen_id }}__title { margin:0 0 18px; font-family:{{ settings.type_heading_font.family }}, Georgia, serif; font-size:32px; line-height:1.15; font-weight:500; }
  .ai-luxury-product-{{ ai_gen_id }}__price { display:flex; gap:12px; align-items:center; margin-bottom:28px; font-size:18px; }
  .ai-luxury-product-{{ ai_gen_id }}__compare { color:#6A665F; text-decoration:line-through; }
  .ai-luxury-product-{{ ai_gen_id }}__label { display:block; margin:0 0 10px; font-size:12px; letter-spacing:.08em; text-transform:uppercase; }
  .ai-luxury-product-{{ ai_gen_id }}__variants { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }
  .ai-luxury-product-{{ ai_gen_id }}__variant { border:1px solid #B9B4AC; border-radius:14px; background:transparent; color:#2C2C2C; padding:9px 14px; cursor:pointer; }
  .ai-luxury-product-{{ ai_gen_id }}__variant[aria-pressed="true"] { background:#2C2C2C; border-color:#2C2C2C; color:#F5F2EE; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity { display:flex; width:128px; height:44px; border:1px solid #B9B4AC; border-radius:4px; margin-bottom:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity button, .ai-luxury-product-{{ ai_gen_id }}__quantity input { border:0; background:transparent; color:#2C2C2C; text-align:center; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity button { width:38px; cursor:pointer; font-size:18px; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity input { width:52px; appearance:textfield; }
  .ai-luxury-product-{{ ai_gen_id }}__add { width:100%; min-height:50px; border:0; border-radius:14px; background:#2C2C2C; color:#F5F2EE; cursor:pointer; letter-spacing:.08em; text-transform:uppercase; }
  .ai-luxury-product-{{ ai_gen_id }}__accordions { margin-top:34px; border-top:1px solid #D3CEC5; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion { border-bottom:1px solid #D3CEC5; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion summary { padding:18px 0; cursor:pointer; list-style:none; display:flex; justify-content:space-between; font-size:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion summary::-webkit-details-marker { display:none; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion summary::after { content:'+'; color:#8A6D24; font-size:20px; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion[open] summary::after { content:'−'; }
  .ai-luxury-product-{{ ai_gen_id }}__content { padding:0 0 18px; line-height:1.7; font-size:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__badges { display:flex; flex-wrap:wrap; gap:16px; margin-top:28px; color:#6A665F; font-size:11px; letter-spacing:.04em; }
  @media (max-width:749px) { .ai-luxury-product-{{ ai_gen_id }}__inner { width:100%; padding:20px; display:block; } .ai-luxury-product-{{ ai_gen_id }}__gallery { position:static; margin-bottom:36px; } .ai-luxury-product-{{ ai_gen_id }}__title { font-size:28px; } }
{% endstyle %}

<luxury-product-{{ ai_gen_id }} class="ai-luxury-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-product-{{ ai_gen_id }}__inner">
    <div class="ai-luxury-product-{{ ai_gen_id }}__gallery">
      <div class="ai-luxury-product-{{ ai_gen_id }}__main">
        {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" data-main-image>{% else %}<div class="ai-luxury-product-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
      </div>
      {% if product.images.size > 0 %}<div class="ai-luxury-product-{{ ai_gen_id }}__thumbs" role="list">{% for image in product.images %}<button class="ai-luxury-product-{{ ai_gen_id }}__thumb" type="button" aria-label="View product image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-image="{{ image | image_url: width: 1400 }}" data-alt="{{ image.alt | default: product.title | escape }}"><img src="{{ image | image_url: width: 180 }}" alt="" width="72" height="90" loading="lazy"></button>{% endfor %}</div>{% endif %}
    </div>
    <div class="ai-luxury-product-{{ ai_gen_id }}__info">
      <p class="ai-luxury-product-{{ ai_gen_id }}__vendor">{{ product.vendor }}</p>
      <h1 class="ai-luxury-product-{{ ai_gen_id }}__title">{{ product.title }}</h1>
      <div class="ai-luxury-product-{{ ai_gen_id }}__price"><span data-price>{{ current_variant.price | money }}</span>{% if current_variant.compare_at_price > current_variant.price %}<span class="ai-luxury-product-{{ ai_gen_id }}__compare" data-compare>{{ current_variant.compare_at_price | money }}</span>{% endif %}</div>
      <form action="/cart/add" method="post" data-product-form>
        <label class="ai-luxury-product-{{ ai_gen_id }}__label">Select a variant</label>
        <div class="ai-luxury-product-{{ ai_gen_id }}__variants">{% for variant in product.variants %}<button type="button" class="ai-luxury-product-{{ ai_gen_id }}__variant" aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}" data-variant-id="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>{% endfor %}</div>
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
        <label class="ai-luxury-product-{{ ai_gen_id }}__label" for="quantity-{{ ai_gen_id }}">Quantity</label>
        <div class="ai-luxury-product-{{ ai_gen_id }}__quantity"><button type="button" data-minus aria-label="Decrease quantity">−</button><input id="quantity-{{ ai_gen_id }}" type="number" name="quantity" value="1" min="1" aria-label="Quantity" data-quantity><button type="button" data-plus aria-label="Increase quantity">+</button></div>
        <button class="ai-luxury-product-{{ ai_gen_id }}__add" type="submit" name="add">Add to cart</button>
      </form>
      <div class="ai-luxury-product-{{ ai_gen_id }}__accordions">
        <details class="ai-luxury-product-{{ ai_gen_id }}__accordion"><summary>Product description</summary><div class="ai-luxury-product-{{ ai_gen_id }}__content">{{ product.description }}</div></details>
        <details class="ai-luxury-product-{{ ai_gen_id }}__accordion"><summary>Shipping and returns</summary><div class="ai-luxury-product-{{ ai_gen_id }}__content">{{ product.metafields.custom.shipping_returns.value }}</div></details>
        <details class="ai-luxury-product-{{ ai_gen_id }}__accordion"><summary>Size and fit</summary><div class="ai-luxury-product-{{ ai_gen_id }}__content">{{ product.metafields.custom.size_and_fit.value }}</div></details>
      </div>
      <div class="ai-luxury-product-{{ ai_gen_id }}__badges"><span>Free Shipping</span><span>Easy Returns</span><span>Authenticity Guaranteed</span></div>
    </div>
  </div>
</luxury-product-{{ ai_gen_id }}>

<script>
(function(){
  class LuxuryProduct{{ ai_gen_id }} extends HTMLElement {
    connectedCallback(){
      this.main=this.querySelector('[data-main-image]'); this.input=this.querySelector('[data-variant-input]'); this.price=this.querySelector('[data-price]'); this.compare=this.querySelector('[data-compare]'); this.quantity=this.querySelector('[data-quantity]');
      this.querySelectorAll('[data-image]').forEach((button)=>button.addEventListener('click',()=>{if(this.main){this.main.src=button.dataset.image;this.main.alt=button.dataset.alt;}this.querySelectorAll('[data-image]').forEach((item)=>item.setAttribute('aria-current','false'));button.setAttribute('aria-current','true');}));
      this.querySelectorAll('[data-variant-id]').forEach((button)=>button.addEventListener('click',()=>{this.input.value=button.dataset.variantId;this.price.textContent=button.dataset.price;this.querySelectorAll('[data-variant-id]').forEach((item)=>item.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');if(this.compare){this.compare.textContent=button.dataset.compare;this.compare.hidden=!button.dataset.compare;}}));
      this.querySelector('[data-minus]').addEventListener('click',()=>{this.quantity.value=Math.max(1,Number(this.quantity.value)-1)}); this.querySelector('[data-plus]').addEventListener('click',()=>{this.quantity.value=Number(this.quantity.value)+1});
    }
  }
  customElements.define('luxury-product-{{ ai_gen_id }}',LuxuryProduct{{ ai_gen_id }});
})();
</script>

{% schema %}
{"name":"Luxury product page","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Luxury product page"}],"tag":null,"class":"luxury-product-page"}
{% endschema %}