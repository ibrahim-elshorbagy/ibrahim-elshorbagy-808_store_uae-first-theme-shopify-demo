
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lookbook-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;

    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};

    /* Stretch the background without using 100vw */
    box-shadow:
      0 0 0 100vmax {{ block.settings.background_color }};

    clip-path: inset(0 -100vmax);

    overflow: clip;
  }

  .ai-lookbook-{{ ai_gen_id }} *,
  .ai-lookbook-{{ ai_gen_id }} *::before,
  .ai-lookbook-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  /* CENTERED CONTENT */
  .ai-lookbook-{{ ai_gen_id }}__inner {
    position: relative;

    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1280px;

    margin-left: auto;
    margin-right: auto;

    padding: 88px 32px 96px;
  }

  /* GIANT TITLE */
  .ai-lookbook-{{ ai_gen_id }}__title {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: 100%;

    margin: 0;

    font-family: 'Anton', sans-serif;
    font-size: clamp(88px, 17vw, 250px);
    font-weight: 400;
    line-height: .85;
    letter-spacing: -.01em;
    text-transform: uppercase;

    overflow-wrap: normal;
    white-space: normal;
  }

  /* OUTLINED WORD */
  .ai-lookbook-{{ ai_gen_id }}__outline {
    background: transparent;
    color: transparent;

    -webkit-text-stroke:
      {{ block.settings.outline_width }}px
      {{ block.settings.text_color }};

    text-stroke:
      {{ block.settings.outline_width }}px
      {{ block.settings.text_color }};
  }

  /* COLLAGE */
  .ai-lookbook-{{ ai_gen_id }}__collage {
    position: relative;

    width: 100%;
    max-width: 100%;

    height: 480px;

    margin-top: -40px;
  }

  /* IMAGES */
  .ai-lookbook-{{ ai_gen_id }}__image {
    position: absolute;

    overflow: hidden;

    background: {{ block.settings.placeholder_color }};

    box-shadow: 0 24px 60px rgba(0, 0, 0, .18);
  }

  .ai-lookbook-{{ ai_gen_id }}__image img,
  .ai-lookbook-{{ ai_gen_id }}__placeholder,
  .ai-lookbook-{{ ai_gen_id }}__placeholder svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .ai-lookbook-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-lookbook-{{ ai_gen_id }}__placeholder svg {
    color: #777;
  }

  /* LEFT IMAGE */
  .ai-lookbook-{{ ai_gen_id }}__image--one {
    width: 300px;
    height: 380px;

    left: 4%;
    top: 0;

    transform: rotate(-4deg);

    z-index: 2;
  }

  /* CENTER IMAGE */
  .ai-lookbook-{{ ai_gen_id }}__image--two {
    width: 340px;
    height: 280px;

    left: 36%;
    top: 60px;

    transform: rotate(2deg);

    z-index: 3;
  }

  /* RIGHT IMAGE */
  .ai-lookbook-{{ ai_gen_id }}__image--three {
    width: 260px;
    height: 340px;

    right: 6%;
    top: -30px;

    transform: rotate(5deg);

    z-index: 2;
  }

  /* LABEL */
  .ai-lookbook-{{ ai_gen_id }}__tag {
    position: absolute;

    left: 30%;
    bottom: 40px;

    z-index: 4;

    max-width: calc(100% - 40px);

    padding: 10px 18px;

    background: {{ block.settings.tag_background }};
    color: {{ block.settings.tag_text_color }};

    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .25em;
    line-height: 1.2;
    border-radius: 999px;

    white-space: nowrap;
  }

  /* FOOTER */
  .ai-lookbook-{{ ai_gen_id }}__footer {
    display: flex;

    align-items: center;
    flex-wrap: wrap;

    gap: 20px;

    margin-top: 24px;

    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
  }

  .ai-lookbook-{{ ai_gen_id }}__cta {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 6px;

    color: {{ block.settings.text_color }};

    text-decoration: none;

    transition: transform .15s ease, opacity .15s ease;
  }

  .ai-lookbook-{{ ai_gen_id }}__cta:active {
    transform: scale(.97);
    opacity: .85;
  }

  .ai-lookbook-{{ ai_gen_id }}__cta-arrow {
    display: inline-block;

    transition: transform .2s ease;
  }

  .ai-lookbook-{{ ai_gen_id }}__cta:hover
  .ai-lookbook-{{ ai_gen_id }}__cta-arrow,

  .ai-lookbook-{{ ai_gen_id }}__cta:focus-visible
  .ai-lookbook-{{ ai_gen_id }}__cta-arrow {
    transform: translateX(4px);
  }

  .ai-lookbook-{{ ai_gen_id }}__meta {
    color: {{ block.settings.muted_text_color }};
  }

  /* TABLET / MOBILE */
  @media screen and (max-width: 800px) {

    .ai-lookbook-{{ ai_gen_id }}__inner {
      width: 100%;
      max-width: 100%;

      padding: 56px 20px 64px;
    }

    .ai-lookbook-{{ ai_gen_id }}__title {
      font-size: clamp(38px, 11vw, 72px);
    }

    /* Collage is now just a plain block wrapper: scroller on top, tag below it */
    .ai-lookbook-{{ ai_gen_id }}__collage {
      display: block;

      width: 100%;
      height: auto;

      margin-top: 28px;
    }

    /* The actual x-scroller — images only, tag lives outside this */
    .ai-lookbook-{{ ai_gen_id }}__scroller {
      display: flex;
      flex-wrap: nowrap;
      align-items: flex-start;

      gap: 14px;

      width: 100%;

      overflow-x: auto;
      overflow-y: visible;

      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x;

      padding-bottom: 8px;
      padding-top: 4px;

      -ms-overflow-style: none;
      scrollbar-width: thin;
    }

    .ai-lookbook-{{ ai_gen_id }}__scroller::-webkit-scrollbar {
      height: 4px;
    }

    .ai-lookbook-{{ ai_gen_id }}__image,
    .ai-lookbook-{{ ai_gen_id }}__image--one,
    .ai-lookbook-{{ ai_gen_id }}__image--two,
    .ai-lookbook-{{ ai_gen_id }}__image--three {
      position: relative;

      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      inset: auto;

      flex: 0 0 78%;

      width: 78%;
      max-width: 78%;

      height: 320px;

      transform: none;

      scroll-snap-align: center;
    }

    .ai-lookbook-{{ ai_gen_id }}__tag {
      position: relative;

      left: auto;
      right: auto;
      bottom: auto;

      display: block;

      width: max-content;
      max-width: 90%;

      margin: 18px auto 0;

      text-align: center;
    }

    /* FOOTER: stack, CTA becomes a real full-width tap target */
    .ai-lookbook-{{ ai_gen_id }}__footer {
      flex-direction: column;
      align-items: stretch;

      gap: 12px;

      margin-top: 28px;
    }

    .ai-lookbook-{{ ai_gen_id }}__cta {
      order: 1;

      width: 100%;

      padding: 16px 24px;

      background: {{ block.settings.tag_background }};
      color: {{ block.settings.tag_text_color }};

      border-radius: 999px;

      font-size: 14px;
      letter-spacing: .02em;
    }

    .ai-lookbook-{{ ai_gen_id }}__meta {
      order: 2;

      width: 100%;

      font-size: 12px;
      text-align: center;
    }
  }

  /* SMALL MOBILE */
  @media screen and (max-width: 480px) {

    .ai-lookbook-{{ ai_gen_id }}__inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    .ai-lookbook-{{ ai_gen_id }}__title {
      font-size: clamp(30px, 9.5vw, 56px);
    }

    .ai-lookbook-{{ ai_gen_id }}__image,
    .ai-lookbook-{{ ai_gen_id }}__image--one,
    .ai-lookbook-{{ ai_gen_id }}__image--two,
    .ai-lookbook-{{ ai_gen_id }}__image--three {
      flex: 0 0 84%;
      width: 84%;
      max-width: 84%;
      height: 280px;
    }

    .ai-lookbook-{{ ai_gen_id }}__tag {
      font-size: 10px;
      letter-spacing: .18em;
      padding: 9px 14px;
    }

    .ai-lookbook-{{ ai_gen_id }}__cta {
      padding: 15px 22px;
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="ai-lookbook-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-lookbook-{{ ai_gen_id }}__inner">
    <h2 class="ai-lookbook-{{ ai_gen_id }}__title">
      {{ block.settings.title_text | escape }}<span class="ai-lookbook-{{ ai_gen_id }}__outline">{{ block.settings.outline_text | escape }}</span>
    </h2>

    <div class="ai-lookbook-{{ ai_gen_id }}__collage">
      <div class="ai-lookbook-{{ ai_gen_id }}__scroller">
        <div class="ai-lookbook-{{ ai_gen_id }}__image ai-lookbook-{{ ai_gen_id }}__image--one">
          {% if block.settings.image_one %}
            <img
              src="{{ block.settings.image_one | image_url: width: 700 }}"
              alt="{{ block.settings.image_one.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_one.width }}"
              height="{{ block.settings.image_one.height }}"
            >
          {% else %}
            <div class="ai-lookbook-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
        </div>

        <div class="ai-lookbook-{{ ai_gen_id }}__image ai-lookbook-{{ ai_gen_id }}__image--two">
          {% if block.settings.image_two %}
            <img
              src="{{ block.settings.image_two | image_url: width: 700 }}"
              alt="{{ block.settings.image_two.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_two.width }}"
              height="{{ block.settings.image_two.height }}"
            >
          {% else %}
            <div class="ai-lookbook-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
        </div>

        <div class="ai-lookbook-{{ ai_gen_id }}__image ai-lookbook-{{ ai_gen_id }}__image--three">
          {% if block.settings.image_three %}
            <img
              src="{{ block.settings.image_three | image_url: width: 700 }}"
              alt="{{ block.settings.image_three.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_three.width }}"
              height="{{ block.settings.image_three.height }}"
            >
          {% else %}
            <div class="ai-lookbook-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
        </div>
      </div>

      <span class="ai-lookbook-{{ ai_gen_id }}__tag">{{ block.settings.tag_text | escape }}</span>
    </div>

    <div class="ai-lookbook-{{ ai_gen_id }}__footer">
      {% if block.settings.cta_link != blank %}
        <a class="ai-lookbook-{{ ai_gen_id }}__cta" href="{{ block.settings.cta_link }}">
          {{ block.settings.cta_text | escape }}
          <span class="ai-lookbook-{{ ai_gen_id }}__cta-arrow" aria-hidden="true">→</span>
        </a>
      {% endif %}
      <span class="ai-lookbook-{{ ai_gen_id }}__meta">{{ block.settings.meta_text | escape }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Giant type lookbook",
  "tag": null,
  "class": "giant-type-lookbook",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "title_text", "label": "Solid title", "default": "EVERY" },
    { "type": "text", "id": "outline_text", "label": "Outline title", "default": "DAY" },
    { "type": "text", "id": "tag_text", "label": "Collage label", "default": "EVERYDAY · 3 LOOKS" },
    { "type": "text", "id": "meta_text", "label": "Category text", "default": "Sneakers · Sandals" },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Explore the Style" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_one", "label": "Left image" },
    { "type": "image_picker", "id": "image_two", "label": "Center image" },
    { "type": "image_picker", "id": "image_three", "label": "Right image" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop content width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "outline_width", "label": "Outline stroke width", "min": 1, "max": 5, "step": 0.5, "unit": "px", "default": 2.5 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F2EFE6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#777777" },
    { "type": "color", "id": "tag_background", "label": "Label background", "default": "#111111" },
    { "type": "color", "id": "tag_text_color", "label": "Label text", "default": "#FFFFFF" },
    { "type": "color", "id": "placeholder_color", "label": "Image placeholder", "default": "#DDDDDD" }
  ],
  "presets": [
    { "name": "Giant type lookbook" }
  ]
}
{% endschema %}
