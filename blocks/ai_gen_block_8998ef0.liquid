{% doc %}
  @prompt
    Redesign and upgrade the "Main Collection cards" block with a modern, premium look. The block should allow merchants to manually select specific Shopify collections (using collection pickers in theme settings) and display them as beautiful cards. Each card should show: collection image (full cover), collection title in elegant typography, a subtle hover effect (zoom or overlay), and a "Shop Now" button. Design should be clean, luxury/fashion style with smooth animations. Support selecting 2-6 collections. Cards should be in a responsive grid (3 columns on desktop, 2 on tablet, 1 on mobile). Use Liquid to fetch real collection data from the selected collections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-cards-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-cards__heading-{{ ai_gen_id }} {
    margin: 0 0 28px;
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .ai-collection-cards__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-collection-cards__card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    min-height: {{ block.settings.card_height }}px;
    overflow: hidden;
    background: {{ block.settings.placeholder_color }};
    text-decoration: none;
    color: {{ block.settings.overlay_text_color }};
    isolation: isolate;
  }

  .ai-collection-cards__media-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .ai-collection-cards__media-{{ ai_gen_id }} img,
  .ai-collection-cards__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .ai-collection-cards__media-{{ ai_gen_id }} svg {
    color: {{ block.settings.text_color }};
    opacity: 0.35;
  }

  .ai-collection-cards__shade-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 20%, rgba(0, 0, 0, 0.72) 100%);
    transition: background 350ms ease;
  }

  .ai-collection-cards__content-{{ ai_gen_id }} {
    display: flex;
    min-height: {{ block.settings.card_height }}px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 28px;
  }

  .ai-collection-cards__title-{{ ai_gen_id }} {
    margin: 0 0 16px;
    color: {{ block.settings.overlay_text_color }};
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 500;
    line-height: 1.1;
  }

  .ai-collection-cards__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 18px;
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 250ms ease, color 250ms ease, border-color 250ms ease;
  }

  .ai-collection-cards__card-{{ ai_gen_id }}:hover .ai-collection-cards__media-{{ ai_gen_id }} img,
  .ai-collection-cards__card-{{ ai_gen_id }}:focus-visible .ai-collection-cards__media-{{ ai_gen_id }} img {
    transform: scale(1.06);
  }

  .ai-collection-cards__card-{{ ai_gen_id }}:hover .ai-collection-cards__shade-{{ ai_gen_id }},
  .ai-collection-cards__card-{{ ai_gen_id }}:focus-visible .ai-collection-cards__shade-{{ ai_gen_id }} {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 10%, rgba(0, 0, 0, 0.82) 100%);
  }

  .ai-collection-cards__card-{{ ai_gen_id }}:hover .ai-collection-cards__button-{{ ai_gen_id }},
  .ai-collection-cards__card-{{ ai_gen_id }}:focus-visible .ai-collection-cards__button-{{ ai_gen_id }} {
    background: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-collection-cards__card-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-cards-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-collection-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-collection-cards__card-{{ ai_gen_id }},
    .ai-collection-cards__content-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_card_height }}px;
    }

    .ai-collection-cards__content-{{ ai_gen_id }} {
      padding: 22px;
    }
  }
{% endstyle %}

<div class="ai-collection-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-collection-cards__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-collection-cards__grid-{{ ai_gen_id }}">
    {% for collection in block.settings.collections %}
      {% if collection != blank %}
        <a class="ai-collection-cards__card-{{ ai_gen_id }}" href="{{ collection.url }}" aria-label="Shop {{ collection.title | escape }}">
          <div class="ai-collection-cards__media-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 1200 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="1200" height="{{ block.settings.card_height }}">
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-collection-cards__shade-{{ ai_gen_id }}"></div>
          <div class="ai-collection-cards__content-{{ ai_gen_id }}">
            <h3 class="ai-collection-cards__title-{{ ai_gen_id }}">{{ collection.title | escape }}</h3>
            <span class="ai-collection-cards__button-{{ ai_gen_id }}">{{ block.settings.button_label | escape }}</span>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection cards",
  "tag": null,
  "class": "collection-cards-block",
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "paragraph",
      "content": "Select 2 to 6 collections to display as premium cards."
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 6
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "min": 280,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "mobile_card_height",
      "label": "Mobile card height",
      "min": 220,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "inter_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Button font",
      "default": "inter_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 18,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#DFDFDF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection cards"
    }
  ]
}
{% endschema %}