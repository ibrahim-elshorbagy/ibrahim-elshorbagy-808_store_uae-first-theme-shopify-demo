{% doc %}
  @prompt
    Update the existing "Collection Cards" block to display real Shopify collections dynamically using Liquid. Keep the exact same visual design (card layout, typography, colors, hover effects, spacing) but replace static/hardcoded content with live collection data from the store. Each card should show the collection image, collection title, and link to the real collection page. If the current design has a grid layout, maintain it. Make sure it looks identical to the current design but pulls real data automatically from Shopify collections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .collection-cards-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .collection-cards-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .collection-cards-{{ ai_gen_id }}__card {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 0;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .collection-cards-{{ ai_gen_id }}__media {
    position: relative;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background: {{ block.settings.placeholder_background }};
  }

  .collection-cards-{{ ai_gen_id }}__media img,
  .collection-cards-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .collection-cards-{{ ai_gen_id }}__media svg {
    color: {{ block.settings.placeholder_color }};
  }

  .collection-cards-{{ ai_gen_id }}__card:hover .collection-cards-{{ ai_gen_id }}__media img,
  .collection-cards-{{ ai_gen_id }}__card:focus-visible .collection-cards-{{ ai_gen_id }}__media img {
    transform: scale(1.04);
  }

  .collection-cards-{{ ai_gen_id }}__title {
    margin: 0;
    padding: {{ block.settings.title_padding }}px;
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: {{ block.settings.text_alignment }};
  }

  .collection-cards-{{ ai_gen_id }}__empty {
    padding: 32px;
    border: 1px dashed {{ block.settings.text_color }};
    border-radius: {{ block.settings.card_radius }}px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .collection-cards-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .collection-cards-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_title_size }}px;
      padding: {{ block.settings.mobile_title_padding }}px;
    }
  }
{% endstyle %}

<div class="collection-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collections != blank %}
    <div class="collection-cards-{{ ai_gen_id }}__grid">
      {% for collection in block.settings.collections %}
        <a class="collection-cards-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }} collection">
          <div class="collection-cards-{{ ai_gen_id }}__media">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 1200 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
            {% elsif collection.products.first.featured_image %}
              <img src="{{ collection.products.first.featured_image | image_url: width: 1200 }}" alt="{{ collection.title | escape }}" loading="lazy" width="{{ collection.products.first.featured_image.width }}" height="{{ collection.products.first.featured_image.height }}">
            {% else %}
              <div class="collection-cards-{{ ai_gen_id }}__placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <h3 class="collection-cards-{{ ai_gen_id }}__title">{{ collection.title }}</h3>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-cards-{{ ai_gen_id }}__empty">Select collections to display.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection cards",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "3 / 4", "label": "Portrait" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Title font",
      "default": "inter_n7"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Mobile title size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_padding",
      "label": "Title spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_title_padding",
      "label": "Mobile title spacing",
      "min": 8,
      "max": 24,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_background",
      "label": "Placeholder background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder icon",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Collection cards"
    }
  ],
  "tag": null,
  "class": "collection-cards-block"
}
{% endschema %}