{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-collection-carousel__inner-{{ ai_gen_id }} {
    max-width: 1160px;
    margin: 0 auto;
  }

  .ai-collection-carousel__header-{{ ai_gen_id }} {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-collection-carousel__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.08;
    font-weight: 500;
  }

  .ai-collection-carousel__description-{{ ai_gen_id }} {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-collection-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }} {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: .35;
    cursor: not-allowed;
  }

  .ai-collection-carousel__viewport-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    transition: transform .35s ease;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - 54px) / 4);
    min-width: 0;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_color }};
    box-shadow: 0 16px 40px rgba(0, 0, 0, .10);
    color: {{ block.settings.text_color }};
  }

  .ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(2) { margin-top: 36px; }
  .ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(4) { margin-top: 56px; }
  .ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(5) { margin-top: 0; }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} {
    height: {{ block.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f1ed;
    color: #555;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} svg { width: 55%; height: 55%; }

  .ai-collection-carousel__info-{{ ai_gen_id }} { padding: 14px; }
  .ai-collection-carousel__title-{{ ai_gen_id }} { margin: 0 0 6px; font-size: 14px; font-weight: 600; }
  .ai-collection-carousel__price-{{ ai_gen_id }} { font-size: 13px; }
  .ai-collection-carousel__link-{{ ai_gen_id }} { color: inherit; text-decoration: none; }
  .ai-collection-carousel__link-{{ ai_gen_id }}:focus-visible,
  .ai-collection-carousel__button-{{ ai_gen_id }}:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-{{ ai_gen_id }} { padding-right: 16px; padding-left: 16px; }
    .ai-collection-carousel__header-{{ ai_gen_id }} { align-items: start; }
    .ai-collection-carousel__heading-{{ ai_gen_id }} { font-size: {{ block.settings.mobile_heading_size }}px; }
    .ai-collection-carousel__card-{{ ai_gen_id }} { flex-basis: 100%; }
    .ai-collection-carousel__card-{{ ai_gen_id }}:nth-child(n) { margin-top: 0; }
    .ai-collection-carousel__image-{{ ai_gen_id }},
    .ai-collection-carousel__placeholder-{{ ai_gen_id }} { height: {{ block.settings.mobile_image_height }}px; }
  }
{% endstyle %}

<collection-product-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-carousel__inner-{{ ai_gen_id }}">
    <div class="ai-collection-carousel__header-{{ ai_gen_id }}">
      <div>
        {% if block.settings.heading != blank %}<h2 class="ai-collection-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<p class="ai-collection-carousel__description-{{ ai_gen_id }}">{{ block.settings.description | escape }}</p>{% endif %}
      </div>
      <div class="ai-collection-carousel__controls-{{ ai_gen_id }}">
        <button class="ai-collection-carousel__button-{{ ai_gen_id }}" type="button" data-direction="prev" aria-label="Previous products">&#8592;</button>
        <button class="ai-collection-carousel__button-{{ ai_gen_id }}" type="button" data-direction="next" aria-label="Next products">&#8594;</button>
      </div>
    </div>

    {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
      <div class="ai-collection-carousel__viewport-{{ ai_gen_id }}">
        <div class="ai-collection-carousel__track-{{ ai_gen_id }}">
          {% for product in block.settings.collection.products limit: block.settings.product_limit %}
            <article class="ai-collection-carousel__card-{{ ai_gen_id }}">
              <a class="ai-collection-carousel__link-{{ ai_gen_id }}" href="{{ product.url }}">
                {% if product.featured_image %}
                  <img class="ai-collection-carousel__image-{{ ai_gen_id }}" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="{{ block.settings.image_height }}">
                {% else %}
                  <div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
                {% endif %}
                <div class="ai-collection-carousel__info-{{ ai_gen_id }}">
                  <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
                  <div class="ai-collection-carousel__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <p>Please select a collection with products.</p>
    {% endif %}
  </div>
</collection-product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionProductCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-collection-carousel__track-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-collection-carousel__card-{{ ai_gen_id }}');
        this.buttons = this.querySelectorAll('[data-direction]');
        this.index = 0;
        this.buttons.forEach((button) => button.addEventListener('click', () => this.move(button.dataset.direction)));
        this.update();
      }
      move(direction) {
        const visible = window.matchMedia('(max-width: 749px)').matches ? 1 : 4;
        const max = Math.max(0, this.cards.length - visible);
        this.index = direction === 'next' ? Math.min(this.index + 1, max) : Math.max(this.index - 1, 0);
        this.update();
      }
      update() {
        if (!this.track || !this.cards.length) return;
        const distance = this.cards[0].getBoundingClientRect().width + 18;
        this.track.style.transform = 'translateX(-' + (this.index * distance) + 'px)';
        const visible = window.matchMedia('(max-width: 749px)').matches ? 1 : 4;
        const max = Math.max(0, this.cards.length - visible);
        this.buttons.forEach((button) => { button.disabled = button.dataset.direction === 'prev' ? this.index === 0 : this.index >= max; });
      }
    }
    customElements.define('collection-product-carousel-{{ ai_gen_id }}', CollectionProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection carousel",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Uneven, like real life." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Different heights. Same quality." },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Style" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "inter_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 220, "max": 520, "step": 10, "unit": "px", "default": 360 },
    { "type": "range", "id": "section_padding", "label": "Section spacing", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 60 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4EAD8" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFDF6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3A2A1C" }
  ],
  "presets": [{ "name": "Collection carousel" }],
  "tag": null,
  "class": "collection-carousel-block"
}
{% endschema %}