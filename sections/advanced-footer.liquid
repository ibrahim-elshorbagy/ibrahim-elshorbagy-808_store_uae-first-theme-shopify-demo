<footer class="af-footer" style="background-color: {{ section.settings.background_color }};">
  <div class="af-inner {% if section.settings.center_content %}af-centered{% endif %}">
    {%- if section.settings.show_logo and section.settings.logo != blank -%}
      <img
        class="af-logo"
        src="{{ section.settings.logo | image_url: width: 128 }}"
        alt="{{ shop.name | escape }}"
        width="64"
        height="64"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h3 class="af-heading">{{ section.settings.heading | escape }}</h3>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="af-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'AdvancedFooterForm', class: 'af-form' -%}
      <input name="contact[tags]" type="hidden" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="af-success">{{ 'blocks.email_signup.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="af-error">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}

      <div class="af-input-wrap">
        <label for="AdvancedFooterEmail" class="visually-hidden">Email</label>
        <input
          id="AdvancedFooterEmail"
          type="email"
          name="contact[email]"
          class="af-input"
          placeholder="{{ section.settings.input_placeholder | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button type="submit" class="af-btn">
          {{ section.settings.button_label | escape }}
        </button>
      </div>
    {%- endform -%}

    {%- liquid
      assign has_social = false
      if section.settings.instagram_url != blank or section.settings.whatsapp_url != blank or section.settings.tiktok_url != blank or section.settings.facebook_url != blank or section.settings.twitter_url != blank or section.settings.youtube_url != blank or section.settings.snapchat_url != blank or section.settings.pinterest_url != blank
        assign has_social = true
      endif
    -%}

    {%- if has_social -%}
      <div class="af-soc">
        {%- if section.settings.instagram_url != blank -%}
          <a
            href="{{ section.settings.instagram_url }}"
            aria-label="Instagram"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 4 4 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 3.6a6.2 6.2 0 100 12.4 6.2 6.2 0 000-12.4zm0 10.2a4 4 0 110-8 4 4 0 010 8zm6.4-10.4a1.4 1.4 0 100-2.9 1.4 1.4 0 000 2.9z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.whatsapp_url != blank -%}
          <a
            href="{{ section.settings.whatsapp_url }}"
            aria-label="WhatsApp"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.3-1.3l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.1-.3.2-.5.1a6.4 6.4 0 01-1.9-1.2 7 7 0 01-1.3-1.6c-.1-.2 0-.4.1-.5l.4-.4.2-.4v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.1 1.6 2.6 4 3.6.6.2 1 .4 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.3-.2-.5-.3z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.tiktok_url != blank -%}
          <a
            href="{{ section.settings.tiktok_url }}"
            aria-label="TikTok"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M16.6 3c.4 2 1.8 3.6 4.4 3.8v3.1c-1.7 0-3.2-.5-4.4-1.4v6.6c0 3.9-2.9 6.6-6.6 6.6-3.6 0-6.4-2.7-6.4-6.2 0-3.7 3-6.4 7-6.1v3.3c-2-.4-3.8.9-3.8 2.9 0 1.7 1.3 2.9 3 2.9 1.9 0 3.2-1.4 3.2-3.5V3h3.6z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.facebook_url != blank -%}
          <a
            href="{{ section.settings.facebook_url }}"
            aria-label="Facebook"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.twitter_url != blank -%}
          <a
            href="{{ section.settings.twitter_url }}"
            aria-label="X (Twitter)"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9L1 2h7l4.8 6.3L18.2 2zm-1.2 18h1.9L7.1 4H5.1l11.9 16z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.youtube_url != blank -%}
          <a
            href="{{ section.settings.youtube_url }}"
            aria-label="YouTube"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M22.5 6.2a2.8 2.8 0 00-2-2C18.9 4 12 4 12 4s-6.9 0-8.5.2a2.8 2.8 0 00-2 2C1.3 7.9 1.3 12 1.3 12s0 4.1.2 5.8a2.8 2.8 0 002 2C5.1 20 12 20 12 20s6.9 0 8.5-.2a2.8 2.8 0 002-2c.2-1.7.2-5.8.2-5.8s0-4.1-.2-5.8zM9.7 15.5V8.5l6.6 3.5-6.6 3.5z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.snapchat_url != blank -%}
          <a
            href="{{ section.settings.snapchat_url }}"
            aria-label="Snapchat"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M12 2c-2.8 0-5 2.2-5 5v1.3c-.4.1-.8.3-1 .7-.3.5-.2 1 .1 1.4-.5 1.2-1.4 2-2.4 2.3-.2.1-.3.3-.2.5.4 1 1.8 1.3 3 1.5.1.3.1.6-.1.9-.1.2 0 .4.2.5.7.3 1.5.4 2.3.5.5.7 1.3 1.4 2.1 1.4s1.6-.7 2.1-1.4c.8-.1 1.6-.2 2.3-.5.2-.1.3-.3.2-.5-.2-.3-.2-.6-.1-.9 1.2-.2 2.6-.5 3-1.5.1-.2 0-.4-.2-.5-1-.3-1.9-1.1-2.4-2.3.3-.4.4-.9.1-1.4-.2-.4-.6-.6-1-.7V7c0-2.8-2.2-5-5-5z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.pinterest_url != blank -%}
          <a
            href="{{ section.settings.pinterest_url }}"
            aria-label="Pinterest"
            target="_blank"
            rel="noopener"
            class="af-soc__link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="af-soc__icon">
              <path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.4 9.3-.1-.8-.1-2 .2-2.9.3-1 1.9-8 1.9-8s-.5-1-.5-2.4c0-2.3 1.3-4 3.3-4 1.5 0 2.3 1.1 2.3 2.5 0 1.5-.9 3.7-1.4 5.8-.4 1.7.8 3.1 2.5 3.1 3 0 5-3.8 5-8.3 0-3.4-2.3-5.9-5.8-5.9-4 0-6.4 3-6.4 6.2 0 1.2.5 2.5 1 3.2.1.1.1.3.1.4l-.4 1.5c-.1.2-.2.3-.4.2-1.9-.9-3-3.6-3-5.8 0-4.7 3.4-9 9.8-9 5.2 0 9.2 3.7 9.2 8.6 0 5.1-3.2 9.2-7.7 9.2-1.5 0-2.9-.8-3.4-1.7l-.9 3.6c-.3 1.2-1.2 2.8-1.8 3.7.7.2 1.4.3 2.1.3 5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="af-bot">
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}
      {%- if section.settings.tagline != blank -%}
        &nbsp;&middot;&nbsp;{{ section.settings.tagline | escape }}
      {%- endif -%}
    </div>
  </div>
</footer>


{% stylesheet %}

  .af-footer {
    position: relative;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    /* Full-width background without expanding the page */
    box-shadow: 0 0 0 100vmax var(--af-footer-bg, #1d1710);
    clip-path: inset(0 -100vmax);

    font-family: var(--font-body-family, sans-serif);
    color: #f0e6d2;
  }

  .af-inner {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 72px 32px 32px;
    box-sizing: border-box;
  }

  .af-centered {
    text-align: center;
  }

  .af-centered .af-logo {
    display: block;
    margin: 0 auto;
  }

  .af-centered .af-form {
    margin-left: auto;
    margin-right: auto;
  }

  .af-centered .af-soc {
    justify-content: center;
  }

  .af-logo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #b08d3e;
    margin-bottom: 18px;
  }

  .af-heading {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    margin: 0 0 6px;
    color: #f0e6d2;
  }

  .af-sub {
    color: #a89a7c;
    font-size: 14px;
  }

  .af-form {
    width: 100%;
    max-width: 480px;
    margin-top: 26px;
  }

  .af-input-wrap {
    display: flex;
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(176, 141, 62, 0.4);
    border-radius: 100px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .af-input {
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
    background: #fff;
    border: 0;
    padding: 15px 22px;
    color: #1d1710;
    font-size: 14px;
    outline: none;
    font-family: inherit;
    box-sizing: border-box;
  }

  .af-input::placeholder {
    color: #999;
  }

  .af-btn {
    flex: 0 0 auto;
    background: #b08d3e;
    color: #1d1710;
    border: 0;
    padding: 0 30px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .af-btn:hover {
    opacity: 0.85;
  }

  .af-success {
    color: #b08d3e;
    font-size: 13px;
    margin-bottom: 12px;
  }

  .af-error {
    color: #e07070;
    font-size: 13px;
    margin-bottom: 12px;
  }

  .af-soc {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .af-soc__link {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(176, 141, 62, 0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: border-color 0.2s;
    flex-shrink: 0;
  }

  .af-soc__link:hover {
    border-color: #b08d3e;
  }

  .af-soc__icon {
    width: 17px;
    height: 17px;
    fill: #d8b36a;
    display: block;
  }

  .af-bot {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 12px;
    color: #8a7a5c;
  }

  .af-bot a {
    color: #8a7a5c;
    text-decoration: none;
  }

  @media (max-width: 749px) {
    .af-inner {
      padding: 48px 20px 24px;
    }

    .af-btn {
      padding: 0 20px;
    }
  }

  @media (max-width: 400px) {
    .af-inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    .af-input {
      padding-left: 14px;
      padding-right: 8px;
    }

    .af-btn {
      padding: 0 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Advanced Footer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1d1710"
    },
    {
      "type": "checkbox",
      "id": "center_content",
      "label": "Center all content",
      "default": true
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the evening list."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Private drops · 10% off your first pair"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Copyright tagline",
      "default": "United Arab Emirates · @808_store_uae"
    },
    {
      "type": "header",
      "content": "Email Signup"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "snapchat_url",
      "label": "Snapchat"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest"
    }
  ],
  "presets": [
    {
      "name": "Advanced Footer"
    }
  ]
}
{% endschema %}
