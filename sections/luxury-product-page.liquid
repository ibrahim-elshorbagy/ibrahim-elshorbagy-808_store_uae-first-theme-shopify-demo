{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}
{% assign current_variant = product.selected_or_first_available_variant %}

{% style %}
  .ai-luxury-product-{{ ai_gen_id }} { display:block; width:100%; background:#F5F2EE; color:#2C2C2C; }
  .ai-luxury-product-{{ ai_gen_id }}__inner { width:{{ section.settings.desktop_width_percent }}%; max-width:1400px; margin:0 auto; padding:60px; display:grid; grid-template-columns:55fr 45fr; gap:56px; box-sizing:border-box; }
  .ai-luxury-product-{{ ai_gen_id }}__gallery { position:sticky; top:24px; align-self:start; }
  .ai-luxury-product-{{ ai_gen_id }}__main { aspect-ratio:4/5; overflow:hidden; border-radius:4px; background:transparent; }
  .ai-luxury-product-{{ ai_gen_id }}__main img { width:100%; height:100%; display:block; object-fit:cover; }
  .ai-luxury-product-{{ ai_gen_id }}__placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:transparent; }
  .ai-luxury-product-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; }
  .ai-luxury-product-{{ ai_gen_id }}__thumbs { display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__thumb { width:72px; height:90px; padding:0; border:1px solid transparent; border-radius:4px; overflow:hidden; background:transparent; cursor:pointer; }
  .ai-luxury-product-{{ ai_gen_id }}__thumb[aria-current="true"] { border-color:#C9A84C; }
  .ai-luxury-product-{{ ai_gen_id }}__thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .ai-luxury-product-{{ ai_gen_id }}__vendor { margin:0 0 14px; color:#8A6D24; font-size:11px; letter-spacing:.16em; text-transform:uppercase; }
  .ai-luxury-product-{{ ai_gen_id }}__title { margin:0 0 18px; font-family:{{ settings.type_heading_font.family }}, Georgia, serif; font-size:32px; line-height:1.15; font-weight:500; }
  .ai-luxury-product-{{ ai_gen_id }}__price { display:flex; gap:12px; align-items:center; margin-bottom:28px; font-size:18px; }
  .ai-luxury-product-{{ ai_gen_id }}__compare { color:#6A665F; text-decoration:line-through; }
  .ai-luxury-product-{{ ai_gen_id }}__option-group { margin-bottom:20px; }
  .ai-luxury-product-{{ ai_gen_id }}__label { display:block; margin:0 0 10px; font-size:12px; letter-spacing:.08em; text-transform:uppercase; }
  .ai-luxury-product-{{ ai_gen_id }}__variants { display:flex; flex-wrap:wrap; gap:8px; }
  .ai-luxury-product-{{ ai_gen_id }}__variant { border:1px solid #B9B4AC; border-radius:14px; background:transparent; color:#2C2C2C; padding:9px 14px; cursor:pointer; font-size:13px; }
  .ai-luxury-product-{{ ai_gen_id }}__variant[aria-pressed="true"] { background:#2C2C2C; border-color:#2C2C2C; color:#F5F2EE; }
  .ai-luxury-product-{{ ai_gen_id }}__variant:disabled { opacity:.4; cursor:not-allowed; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity { display:flex; width:128px; height:44px; border:1px solid #B9B4AC; border-radius:4px; margin-bottom:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity button, .ai-luxury-product-{{ ai_gen_id }}__quantity input { border:0; background:transparent; color:#2C2C2C; text-align:center; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity button { width:38px; cursor:pointer; font-size:18px; }
  .ai-luxury-product-{{ ai_gen_id }}__quantity input { width:52px; appearance:textfield; -moz-appearance:textfield; }
  .ai-luxury-product-{{ ai_gen_id }}__add { width:100%; min-height:50px; border:0; border-radius:14px; background:#2C2C2C; color:#F5F2EE; cursor:pointer; letter-spacing:.08em; text-transform:uppercase; font-size:13px; }
  .ai-luxury-product-{{ ai_gen_id }}__add:disabled { opacity:.5; cursor:not-allowed; }
  .ai-luxury-product-{{ ai_gen_id }}__accordions { margin-top:34px; border-top:1px solid #D3CEC5; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion { border-bottom:1px solid #D3CEC5; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion summary { padding:18px 0; cursor:pointer; list-style:none; display:flex; justify-content:space-between; font-size:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion summary::-webkit-details-marker { display:none; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion summary::after { content:'+'; color:#8A6D24; font-size:20px; }
  .ai-luxury-product-{{ ai_gen_id }}__accordion[open] summary::after { content:'−'; }
  .ai-luxury-product-{{ ai_gen_id }}__content { padding:0 0 18px; line-height:1.7; font-size:14px; }
  .ai-luxury-product-{{ ai_gen_id }}__badges { display:flex; flex-wrap:wrap; gap:16px; margin-top:28px; color:#6A665F; font-size:11px; letter-spacing:.04em; }
  @media (max-width:749px) {
    .ai-luxury-product-{{ ai_gen_id }}__inner { width:100%; padding:20px; display:block; }
    .ai-luxury-product-{{ ai_gen_id }}__gallery { position:static; margin-bottom:36px; }
    .ai-luxury-product-{{ ai_gen_id }}__title { font-size:28px; }
  }
{% endstyle %}

<script>
  window['luxuryVariants_{{ ai_gen_id }}'] = {{ product.variants | json }};
</script>

<luxury-product-{{ ai_gen_id }} class="ai-luxury-product-{{ ai_gen_id }}" {{ section.shopify_attributes }}>
  <div class="ai-luxury-product-{{ ai_gen_id }}__inner">

    <div class="ai-luxury-product-{{ ai_gen_id }}__gallery">
      <div class="ai-luxury-product-{{ ai_gen_id }}__main">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1400 }}"
            srcset="
              {{ product.featured_image | image_url: width: 600 }} 600w,
              {{ product.featured_image | image_url: width: 900 }} 900w,
              {{ product.featured_image | image_url: width: 1200 }} 1200w,
              {{ product.featured_image | image_url: width: 1400 }} 1400w
            "
            sizes="(max-width: 749px) 100vw, 55vw"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            loading="eager"
            fetchpriority="high"
            data-main-image
          >
        {% else %}
          <div class="ai-luxury-product-{{ ai_gen_id }}__placeholder">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="ai-luxury-product-{{ ai_gen_id }}__thumbs" role="list">
          {% for image in product.images %}
            <button
              class="ai-luxury-product-{{ ai_gen_id }}__thumb"
              type="button"
              aria-label="View image {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              data-image="{{ image | image_url: width: 1400 }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
            >
              <img
                src="{{ image | image_url: width: 180 }}"
                srcset="
                  {{ image | image_url: width: 72 }} 72w,
                  {{ image | image_url: width: 144 }} 144w,
                  {{ image | image_url: width: 180 }} 180w
                "
                sizes="72px"
                alt="{{ image.alt | default: product.title | escape }}"
                width="72"
                height="90"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="ai-luxury-product-{{ ai_gen_id }}__info">
      <p class="ai-luxury-product-{{ ai_gen_id }}__vendor">{{ product.vendor | escape }}</p>
      <h1 class="ai-luxury-product-{{ ai_gen_id }}__title">{{ product.title | escape }}</h1>

      <div class="ai-luxury-product-{{ ai_gen_id }}__price">
        <span data-price>{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="ai-luxury-product-{{ ai_gen_id }}__compare" data-compare>
            {{ current_variant.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      <form action="/cart/add" method="post" data-product-form>

        {% for option in product.options_with_values %}
          <div class="ai-luxury-product-{{ ai_gen_id }}__option-group">
            <span class="ai-luxury-product-{{ ai_gen_id }}__label">{{ option.name | escape }}</span>
            <div class="ai-luxury-product-{{ ai_gen_id }}__variants">
              {% for value in option.values %}
                <button
                  type="button"
                  class="ai-luxury-product-{{ ai_gen_id }}__variant"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-option-value="{{ value | escape }}"
                  aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                >{{ value | escape }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

        <label class="ai-luxury-product-{{ ai_gen_id }}__label" for="qty-{{ ai_gen_id }}">Quantity</label>
        <div class="ai-luxury-product-{{ ai_gen_id }}__quantity">
          <button type="button" data-minus aria-label="Decrease quantity">−</button>
          <input id="qty-{{ ai_gen_id }}" type="number" name="quantity" value="1" min="1" aria-label="Quantity" data-quantity>
          <button type="button" data-plus aria-label="Increase quantity">+</button>
        </div>

        <button class="ai-luxury-product-{{ ai_gen_id }}__add" type="submit" name="add" data-add-btn>
          Add to cart
        </button>

      </form>

      <div class="ai-luxury-product-{{ ai_gen_id }}__accordions">
        {% if product.description != blank %}
          <details class="ai-luxury-product-{{ ai_gen_id }}__accordion">
            <summary>Product description</summary>
            <div class="ai-luxury-product-{{ ai_gen_id }}__content">{{ product.description }}</div>
          </details>
        {% endif %}

        {% assign shipping_returns = product.metafields.custom.shipping_returns.value %}
        {% if shipping_returns != blank %}
          <details class="ai-luxury-product-{{ ai_gen_id }}__accordion">
            <summary>Shipping &amp; returns</summary>
            <div class="ai-luxury-product-{{ ai_gen_id }}__content">{{ shipping_returns }}</div>
          </details>
        {% endif %}

        {% assign size_and_fit = product.metafields.custom.size_and_fit.value %}
        {% if size_and_fit != blank %}
          <details class="ai-luxury-product-{{ ai_gen_id }}__accordion">
            <summary>Size &amp; fit</summary>
            <div class="ai-luxury-product-{{ ai_gen_id }}__content">{{ size_and_fit }}</div>
          </details>
        {% endif %}
      </div>

      <div class="ai-luxury-product-{{ ai_gen_id }}__badges">
        <span>Free Shipping</span>
        <span>Easy Returns</span>
        <span>Authenticity Guaranteed</span>
      </div>
    </div>

  </div>
</luxury-product-{{ ai_gen_id }}>

<script>
(function () {
  const ALL_VARIANTS = window['luxuryVariants_{{ ai_gen_id }}'] || [];

  class LuxuryProduct extends HTMLElement {
    connectedCallback() {
      this._selectedOptions = [];

      const currentVariantId = parseInt(this.querySelector('[data-variant-input]').value, 10);
      const currentVariant = ALL_VARIANTS.find(v => v.id === currentVariantId);
      if (currentVariant) this._selectedOptions = [...currentVariant.options];

      this.querySelectorAll('[data-image]').forEach(btn => {
        btn.addEventListener('click', () => {
          const mainImg = this.querySelector('[data-main-image]');
          if (mainImg) { mainImg.src = btn.dataset.image; mainImg.alt = btn.dataset.alt; }
          this.querySelectorAll('[data-image]').forEach(b => b.setAttribute('aria-current', 'false'));
          btn.setAttribute('aria-current', 'true');
        });
      });

      this.querySelectorAll('[data-option-value]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.dataset.optionIndex, 10);
          this._selectedOptions[idx] = btn.dataset.optionValue;
          btn.closest('.ai-luxury-product-{{ ai_gen_id }}__variants')
            .querySelectorAll('[data-option-value]')
            .forEach(b => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          this._matchVariant();
        });
      });

      const qty = this.querySelector('[data-quantity]');
      this.querySelector('[data-minus]').addEventListener('click', () => {
        qty.value = Math.max(1, Number(qty.value) - 1);
      });
      this.querySelector('[data-plus]').addEventListener('click', () => {
        qty.value = Number(qty.value) + 1;
      });
    }

    _matchVariant() {
      const match = ALL_VARIANTS.find(v =>
        v.options.every((opt, i) => opt === this._selectedOptions[i])
      );
      const input   = this.querySelector('[data-variant-input]');
      const priceEl = this.querySelector('[data-price]');
      const compEl  = this.querySelector('[data-compare]');
      const addBtn  = this.querySelector('[data-add-btn]');

      if (match) {
        input.value = match.id;
        priceEl.textContent = this._money(match.price);
        if (compEl) {
          if (match.compare_at_price && match.compare_at_price > match.price) {
            compEl.textContent = this._money(match.compare_at_price);
            compEl.hidden = false;
          } else {
            compEl.textContent = '';
            compEl.hidden = true;
          }
        }
        addBtn.disabled = !match.available;
        addBtn.textContent = match.available ? 'Add to cart' : 'Sold out';
      } else {
        addBtn.disabled = true;
        addBtn.textContent = 'Unavailable';
      }
    }

    _money(cents) {
      return (cents / 100).toLocaleString('en-AE', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }) + ' AED';
    }
  }

  if (!customElements.get('luxury-product-{{ ai_gen_id }}')) {
    customElements.define('luxury-product-{{ ai_gen_id }}', LuxuryProduct);
  }
})();
</script>

{% schema %}
{
  "name": "Luxury product page",
  "tag": "section",
  "class": "luxury-product-page-section",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [{ "name": "Luxury product page" }]
}
{% endschema %}
