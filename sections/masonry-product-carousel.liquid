{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-masonry-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__inner {
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ section.settings.vertical_padding }}px 24px;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__heading {
    margin: 0;
    font-family: {{ section.settings.heading_font.family }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__intro {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__viewport {
    overflow-x: auto;
    overflow-y: visible;
    margin-top: 28px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__viewport::-webkit-scrollbar { display: none; }
  .ai-masonry-carousel-{{ ai_gen_id }}__viewport.is-dragging { cursor: grabbing; }
  .ai-masonry-carousel-{{ ai_gen_id }}__track {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.card_gap }}px;
    width: max-content;
    padding-bottom: 16px;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__slide {
    width: {{ section.settings.card_width }}px;
    flex-shrink: 0;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__slide:nth-child(4n + 2) { margin-top: 34px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__slide:nth-child(4n + 4) { margin-top: 58px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__card {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: {{ section.settings.card_color }};
    border-radius: {{ section.settings.card_radius }}px;
    box-shadow: 0 16px 36px rgba(0,0,0,0.12);
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__media {
    height: {{ section.settings.image_height }}px;
    background: rgba(0,0,0,0.06);
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__media img,
  .ai-masonry-carousel-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__placeholder { height: 100%; }
  .ai-masonry-carousel-{{ ai_gen_id }}__info { padding: 14px; }
  .ai-masonry-carousel-{{ ai_gen_id }}__title { margin: 0 0 6px; font-size: 14px; line-height: 1.35; }
  .ai-masonry-carousel-{{ ai_gen_id }}__price { font-size: 13px; opacity: 0.78; }
  .ai-masonry-carousel-{{ ai_gen_id }}__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 20px;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__button {
    width: 42px;
    height: 42px;
    border: 1px solid {{ section.settings.text_color }};
    border-radius: 50%;
    background: transparent;
    color: {{ section.settings.text_color }};
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
  }
  .ai-masonry-carousel-{{ ai_gen_id }}__button:focus-visible,
  .ai-masonry-carousel-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }
  @media screen and (max-width: 850px) {
    .ai-masonry-carousel-{{ ai_gen_id }}__inner { width: 100%; padding: 44px 18px; }
    .ai-masonry-carousel-{{ ai_gen_id }}__heading { font-size: {{ section.settings.mobile_heading_size }}px; }
    .ai-masonry-carousel-{{ ai_gen_id }}__slide { width: {{ section.settings.mobile_card_width }}px; margin-top: 0 !important; }
    .ai-masonry-carousel-{{ ai_gen_id }}__media { height: {{ section.settings.mobile_image_height }}px; }
  }
{% endstyle %}

<section class="ai-masonry-carousel-{{ ai_gen_id }}" {{ section.shopify_attributes }}>
  <div class="ai-masonry-carousel-{{ ai_gen_id }}__inner">

    {% if section.settings.heading != blank %}
      <h2 class="ai-masonry-carousel-{{ ai_gen_id }}__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="ai-masonry-carousel-{{ ai_gen_id }}__intro">{{ section.settings.description | escape }}</p>
    {% endif %}

    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="ai-masonry-carousel-{{ ai_gen_id }}__viewport" id="viewport-{{ ai_gen_id }}">
        <div class="ai-masonry-carousel-{{ ai_gen_id }}__track">
          {% for product in section.settings.collection.products limit: section.settings.product_limit %}
            <div class="ai-masonry-carousel-{{ ai_gen_id }}__slide">
              <a class="ai-masonry-carousel-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                <div class="ai-masonry-carousel-{{ ai_gen_id }}__media">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      srcset="
                        {{ product.featured_image | image_url: width: 400 }} 400w,
                        {{ product.featured_image | image_url: width: 600 }} 600w,
                        {{ product.featured_image | image_url: width: 900 }} 900w
                      "
                      sizes="(max-width: 850px) 80vw, 25vw"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      width="{{ product.featured_image.width }}"
                      height="{{ section.settings.image_height }}"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="ai-masonry-carousel-{{ ai_gen_id }}__placeholder">
                      {{ 'product-apparel-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-masonry-carousel-{{ ai_gen_id }}__info">
                  <h3 class="ai-masonry-carousel-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3>
                  <div class="ai-masonry-carousel-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="ai-masonry-carousel-{{ ai_gen_id }}__controls">
        <button class="ai-masonry-carousel-{{ ai_gen_id }}__button" type="button" data-target="viewport-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous">&#8592;</button>
        <button class="ai-masonry-carousel-{{ ai_gen_id }}__button" type="button" data-target="viewport-{{ ai_gen_id }}" data-direction="next" aria-label="Next">&#8594;</button>
      </div>

    {% else %}
      <p class="ai-masonry-carousel-{{ ai_gen_id }}__intro">Select a collection to display products.</p>
    {% endif %}

  </div>
</section>

<script>
(function () {
  function initCarousel(viewport) {
    if (!viewport || viewport.dataset.ready) return;
    viewport.dataset.ready = '1';

    const track = viewport.querySelector('[class*="__track"]');
    if (!track) return;

    /* ── Arrow buttons ── */
    const id = viewport.id;
    document.querySelectorAll('[data-target="' + id + '"]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const card = track.firstElementChild;
        if (!card) return;
        const step = card.offsetWidth + parseInt(getComputedStyle(track).gap || 0, 10);
        viewport.scrollBy({ left: btn.dataset.direction === 'next' ? step : -step, behavior: 'smooth' });
      });
    });

    /* ── Drag to scroll ── */
    let startX = 0, scrollLeft = 0, dragging = false;

    viewport.addEventListener('mousedown', function (e) {
      dragging = true;
      startX = e.pageX - viewport.offsetLeft;
      scrollLeft = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('mouseleave', function () { dragging = false; viewport.classList.remove('is-dragging'); });
    viewport.addEventListener('mouseup',    function () { dragging = false; viewport.classList.remove('is-dragging'); });
    viewport.addEventListener('mousemove',  function (e) {
      if (!dragging) return;
      e.preventDefault();
      viewport.scrollLeft = scrollLeft - (e.pageX - viewport.offsetLeft - startX);
    });

    /* ── Touch swipe ── */
    let touchStartX = 0;
    viewport.addEventListener('touchstart', function (e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    viewport.addEventListener('touchend',   function (e) {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) < 10) return;
      const card = track.firstElementChild;
      if (!card) return;
      const step = card.offsetWidth + parseInt(getComputedStyle(track).gap || 0, 10);
      viewport.scrollBy({ left: diff > 0 ? step : -step, behavior: 'smooth' });
    }, { passive: true });
  }

  /* ── Init on load ── */
  document.querySelectorAll('[id^="viewport-"]').forEach(initCarousel);

  /* ── Shopify theme editor live reload ── */
  document.addEventListener('shopify:section:load', function (e) {
    e.target.querySelectorAll('[id^="viewport-"]').forEach(initCarousel);
  });
})();
</script>

{% schema %}
{
  "name": "Masonry product carousel",
  "tag": "section",
  "class": "masonry-product-carousel-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 40, "step": 1, "default": 12 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Uneven, like real life." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Different heights. Same quality." },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "inter_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_width", "label": "Card width (desktop)", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_card_width", "label": "Card width (mobile)", "min": 160, "max": 320, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 260 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4ead8" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#fffdf6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3a2a1c" }
  ],
  "presets": [{ "name": "Masonry product carousel" }]
}
{% endschema %}
