{%- doc -%}
  Displays product images in a carousel.
  @param [children] - Additional content rendered below the card gallery
  @param [section] - The section object the snippet is rendered in
  @param [block] - The block object the snippet is rendered in
{%- enddoc -%}

{% liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign image_sizes = '(min-width: 750px) 50vw, 100vw'

  assign has_badges = false
  assign badge_position = null
  if product != blank
    if product.available == false or product.compare_at_price > product.price
      assign has_badges = true
      assign badge_position = settings.badge_position
    endif
  endif

  if section.settings.product_card_size
    assign mobile_image_size = '100vw'
    if section.settings.mobile_product_card_size == 'small'
      assign mobile_image_size = '50vw'
    endif

    capture card_size
      render 'util-product-grid-card-size', section: section
    endcapture
    assign card_size = card_size | strip | replace: 'px', '' | plus: 0
    capture sizes_attribute
      render 'util-autofill-img-size-attr', card_size: card_size, card_gap: section.settings.columns_gap_horizontal, mobile_size: mobile_image_size
    endcapture
    assign image_sizes = sizes_attribute | strip
  elsif section.settings.columns and section.settings.layout_type != 'editorial'
    assign viewport_width = 100.0 | divided_by: section.settings.columns
    assign sizes_attribute = '(min-width: 750px) [viewport_width]vw, 100vw' | replace: '[viewport_width]', viewport_width
    assign image_sizes = sizes_attribute | strip
  endif

  assign ratio = '1'
  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1'
    when 'adapt'
      assign ratio = product.featured_media.preview_image.aspect_ratio | default: '1'
  endcase

  if block_settings.image_ratio == 'adapt' and block_settings.constrain_to_viewport
    if block_settings.constrain_to_viewport != ''
      assign constrain_to_viewport = true
      assign media_fit = block_settings.constrain_to_viewport
    endif
  endif
%}

<div
  ref="cardGallery"
  class="card-gallery card-gallery-{{ block.id }} spacing-style border-style{% if has_badges %} card-gallery--badge-{{ badge_position }}{% endif %}"
  style="
    {% render 'border-override', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --gallery-aspect-ratio: {{ ratio }};
  "
  data-product-id="{{ product.id }}"
  {% if settings.show_second_image_on_hover and product.media.size > 1 %}
    on:pointerenter="/previewImage"
    on:pointerleave="/resetImage"
  {% endif %}
  {% if settings.transition_to_main_product %}
    data-view-transition-to-main-product
  {% endif %}
  data-image-ratio="{{ block_settings.image_ratio }}"
  {{ block.shopify_attributes }}
>

  {%- unless product == blank -%}
    {%- assign first_variant = product.selected_or_first_available_variant -%}
    <div class="cg-hover-top">
      <span class="cg-hover-top__price">{{ first_variant.price | money }}</span>
    </div>
  {%- endunless -%}

  {%- if product.media.size > 0 -%}
    <a
      class="contents"
      ref="cardGalleryLink"
      href="{{ product.url }}"
      aria-label="{{- product.title -}}"
    >
      {% liquid
        assign featured_media = product.featured_media
        assign featured_media_loading = 'lazy'
        assign featured_media_sizes = 'auto, ' | append: image_sizes
        if section.index == null or section.index < 5
          assign featured_media_loading = 'eager'
          assign featured_media_sizes = image_sizes
        endif

        assign media_class = 'product-media-container media-fit product-media-container--[media_type]'
        assign media_class_suffix = ''
        if constrain_to_viewport
          assign media_class_suffix = ' constrain-height'
        endif
        assign featured_media_class = media_class | replace: '[media_type]', featured_media.media_type | append: media_class_suffix
      %}
      {%- if product.media.size == 1 -%}
        <div
          class="{{ featured_media_class }}"
          style="--product-media-fit: {{ media_fit | default: 'cover' }};"
        >
          {% render 'product-media',
            media: featured_media,
            sizes: featured_media_sizes,
            loading: featured_media_loading,
            preview_image_only: true
          %}
        </div>
      {%- else -%}
        {% liquid
          assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
          assign generic_media_size = product.media.size | minus: variant_images.size
          assign other_media = product.media | reject: 'src', product.featured_media
          assign media_list_to_show = product.featured_media | concat: other_media

          if product.media.size > 2 and generic_media_size > 0
            assign show_arrows = true
          endif

          assign max_visible_slide_count = 1
          if settings.product_card_carousel
            assign max_visible_slide_count = 5
          elsif settings.show_second_image_on_hover
            assign max_visible_slide_count = 2
          endif

          capture slides
            for media in media_list_to_show
              assign hidden = false
              assign attributes = ''
              if variant_images contains media.src
                assign attributes = 'variant-image'
                if forloop.first == false
                  assign hidden = true
                endif
              endif

              if forloop.first
                assign visible_slide_count = 0
              endif
              unless hidden
                assign visible_slide_count = visible_slide_count | plus: 1
              endunless
              if hidden == false and visible_slide_count > max_visible_slide_count
                continue
              endif

              if forloop.first
                assign loading = featured_media_loading
                assign sizes = featured_media_sizes
              else
                assign loading = 'lazy'
                assign sizes = 'auto, ' | append: image_sizes
              endif

              assign class = media_class | replace: '[media_type]', media.media_type | append: media_class_suffix

              capture slideshow_children
                render 'product-media', media: media, sizes: sizes, loading: loading, preview_image_only: true
              endcapture

              render 'slideshow-slide', slide_id: media.id, index: forloop.index0, hidden: hidden, class: class, attributes: attributes, children: slideshow_children, media_fit: media_fit
            endfor
          endcapture

          assign slideshow_attributes = 'data-generic-media-size="[generic_media_size]"' | replace: '[generic_media_size]', generic_media_size
          if settings.product_card_carousel == false
            assign slideshow_attributes = slideshow_attributes | append: ' disabled="true"'
          endif
        %}
        {% render 'slideshow',
          ref: 'slideshow',
          initial_slide: 0,
          slides: slides,
          slide_count: media_list_to_show.size,
          show_arrows: show_arrows,
          attributes: slideshow_attributes
        %}
      {%- endif -%}
    </a>
  {% elsif product != blank and product.media.size == 0 %}
    <div class="product-card-gallery__title-placeholder">
      <a class="contents" ref="cardGalleryLink" href="{{ product.url }}">
        <span class="title-text">{{- product.title -}}</span>
      </a>
    </div>
  {% elsif product == blank %}
    {% liquid
      capture placeholder_image
        assign block_parts = block.id | split: '-'
        assign placeholder_index = block_parts.last | default: 0
        assign variant = placeholder_index | modulo: 3 | plus: 1
        assign placeholder_name = 'product-apparel-' | append: variant
        echo placeholder_name | placeholder_svg_tag
      endcapture
      capture placeholder_slide
        render 'slideshow-slide', index: 1, children: placeholder_image, class: 'product-media-container card-gallery__placeholder'
      endcapture
      render 'slideshow', ref: 'slideshow', slides: placeholder_slide, slide_count: 1, attributes: 'disabled="true"'
    %}
  {%- endif -%}

  {%- unless product == blank -%}
    {%- assign first_variant = product.selected_or_first_available_variant -%}
    <div class="cg-hover-bottom">
      <b class="cg-hover-bottom__title">{{ product.title | escape }}</b>
      {%- if product.available -%}
        <form action="/cart/add" method="post" class="cg-atc-form">
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="cg-hover-bottom__btn">
            {{ 'products.product.add_to_cart' | t | default: 'Add to bag' }}
          </button>
        </form>
      {%- else -%}
        <span class="cg-hover-bottom__btn cg-hover-bottom__btn--soldout">
          {{ 'products.product.sold_out' | t | default: 'Sold out' }}
        </span>
      {%- endif -%}
    </div>
  {%- endunless -%}

  {{ children }}
</div>

{% render 'slideshow-styles' %}
{% render 'product-media-container-styles' %}


{% stylesheet %}
/* =========================================================
   PRODUCT CARD + RESPONSIVE MASONRY GRID
   Natural image dimensions — no forced card height
   ========================================================= */

/* ---------- Product grid: masonry layout ---------- */

/*
  CSS columns allow cards with different image heights to
  flow without the large empty row gaps in your screenshot.

  Note: items flow down each column before moving to the next.
*/

ul.product-grid,
.product-grid {
  display: block !important;
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0;

  columns: 4;
  column-gap: var(--product-grid-horizontal-spacing, 16px);

  /* Override theme grid sizing */
  grid-template-columns: none !important;
  grid-auto-rows: auto !important;
  align-items: start;
}

/* Masonry items */
ul.product-grid > li,
.product-grid > li,
.product-grid > .product-grid__item {
  display: inline-block !important;
  vertical-align: top;

  width: 100% !important;
  max-width: 100%;
  min-width: 0;

  margin: 0 0 var(--product-grid-vertical-spacing, 16px) !important;
  padding: 0;

  break-inside: avoid;
  page-break-inside: avoid;
}

/* ---------- Card base ---------- */

.card-gallery {
  position: relative;
  display: block;

  width: 100%;
  max-width: 100%;
  min-width: 0;

  height: auto !important;
  min-height: 0;

  overflow: hidden;
  border-radius: 18px;
  background: #e9e2d0;

  container-type: inline-size;
  container-name: card-gallery-container;

  /* Do not force a uniform image ratio */
  aspect-ratio: auto !important;
}

/* Keep card contents from creating horizontal overflow */
.card-gallery *,
.card-gallery *::before,
.card-gallery *::after {
  box-sizing: border-box;
  min-width: 0;
}

/* ---------- Hide theme quick-add ---------- */

.card-gallery quick-add-component,
.card-gallery .quick-add,
.card-gallery .quick-add__button,
.card-gallery [class*="quick-add"] {
  display: none !important;
}

/* ---------- Media sizing: preserve image proportions ---------- */

/* Remove forced height and aspect ratios from media wrappers */
.card-gallery .product-media-container,
.card-gallery slideshow-component,
.card-gallery slideshow-slide {
  min-width: 0;
  min-height: 0;
  height: auto !important;
  aspect-ratio: auto !important;
}

/* Keep the gallery link from imposing a fixed height */
.card-gallery > a.contents {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto !important;
}

/* Product images should determine their own height */
.card-gallery .product-media-container img,
.card-gallery slideshow-slide img,
.card-gallery .product-media-container video,
.card-gallery slideshow-slide video {
  display: block;

  width: 100%;
  max-width: 100%;
  height: auto !important;

  object-fit: contain;
}

/* Prevent media from stretching the card */
.card-gallery .product-media-container {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

/* ---------- Image zoom ---------- */

.card-gallery .product-media-container img,
.card-gallery .product-media-container video {
  transition: transform 0.5s ease;
}

@media (hover: hover) and (pointer: fine) {
  .card-gallery:hover .product-media-container img,
  .card-gallery:hover .product-media-container video {
    transform: scale(1.04);
  }
}

/* ---------- Price badge ---------- */

.cg-hover-top {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 3;

  max-width: 100%;
  padding: 10px 12px;

  pointer-events: none;
}

.cg-hover-top__price {
  display: inline-block;
  max-width: 100%;

  padding: 5px 10px;
  border-radius: 100px;

  background: rgba(0, 0, 0, 0.5);
  color: #fff;

  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

/* ---------- Bottom overlay ---------- */

.cg-hover-bottom {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3;

  width: 100%;
  max-width: 100%;
  padding: 42px 16px 16px;

  background: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0, 0, 0, 0.72) 100%
  );

  opacity: 0;
  transform: translateY(8px);

  transition:
    opacity 0.3s ease,
    transform 0.3s ease;

  pointer-events: none;
}

/* Show on hover for mouse users */
@media (hover: hover) and (pointer: fine) {
  .card-gallery:hover .cg-hover-bottom,
  .cg-hover-bottom:focus-within {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
}

/* Product title in overlay */
.cg-hover-bottom__title {
  display: block;

  max-width: 100%;
  margin: 0 0 10px;

  color: #fff;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.4;

  overflow-wrap: anywhere;
}

/* ---------- Add to cart ---------- */

.cg-atc-form {
  width: 100%;
  max-width: 100%;
  margin: 0;
}

.cg-hover-bottom__btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;

  max-width: 100%;
  min-height: 42px;
  padding: 11px 20px;

  border: 0;
  border-radius: 100px;

  background: #fff;
  color: #111;

  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  text-decoration: none;

  cursor: pointer;
  overflow-wrap: anywhere;

  transition: opacity 0.2s ease;
}

.cg-hover-bottom__btn:hover {
  opacity: 0.82;
}

.cg-hover-bottom__btn:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 3px;
}

.cg-hover-bottom__btn--soldout {
  opacity: 0.6;
  cursor: not-allowed;
}

/* ---------- Touch devices ---------- */

@media (hover: none), (pointer: coarse) {
  .cg-hover-bottom {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .cg-hover-bottom__title {
    font-size: 12px;
  }

  .cg-hover-bottom__btn {
    min-height: 38px;
    padding: 9px 14px;
    font-size: 12px;
  }
}

/* ---------- Placeholder card ---------- */

.card-gallery__placeholder {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto !important;
  aspect-ratio: auto !important;
}

.card-gallery__placeholder svg {
  display: block;
  width: 100%;
  height: auto;
}

/* ---------- Product without an image ---------- */

.product-card-gallery__title-placeholder {
  display: block;

  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: auto !important;

  padding: var(--padding-md);

  color: var(--color-foreground);
  background-color: rgb(
    var(--color-foreground-rgb) / var(--opacity-5)
  );

  aspect-ratio: auto !important;
  border-radius: var(--product-corner-radius);

  font-size: var(--font-size--2xl);
  line-height: var(--line-height--display-loose);

  overflow-wrap: anywhere;
}

.product-card-gallery__title-placeholder .title-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  line-clamp: 5;
  overflow: hidden;
}

/* ---------- Slideshow controls ---------- */

.card-gallery slideshow-arrows .slideshow-control {
  padding-inline: var(--padding-xl);
}

@container card-gallery-container (max-width: 249px) {
  .card-gallery slideshow-arrows .slideshow-control {
    padding-inline: 0 var(--padding-sm);
  }

  [dir="rtl"] .card-gallery slideshow-arrows .slideshow-control {
    padding-inline: var(--padding-sm) 0;
  }
}

/* ---------- Lazy slideshow slides ---------- */

.card-gallery
  :is(
    slideshow-slide:has(+ slideshow-slide[aria-hidden="false"]),
    slideshow-slide[aria-hidden="false"] + slideshow-slide
  ) {
  content-visibility: auto;
}

.card-gallery slideshow-component[actioned]
  slideshow-slide {
  content-visibility: visible;
}

/* ---------- Zoom-out view compatibility ---------- */

[product-grid-view="zoom-out"] .card-gallery
  .product-card-gallery__title-placeholder {
  padding: var(--padding-xs) !important;
  font-size: var(--font-size--xs);
}

[product-grid-view="zoom-out"] .card-gallery
  .slideshow-control {
  min-width: auto;
}

ul[product-grid-view="zoom-out"]
  .product-grid__card
  .card-gallery {
  display: block;
}

[product-grid-view="zoom-out"]
  .card-gallery
  > :is(
    quick-add-component,
    .product-badges,
    slideshow-component > slideshow-controls
  ) {
  display: none;
}

ul[product-grid-view="zoom-out"]
  .card-gallery > img {
  display: block;
}

/* =========================================================
   RESPONSIVE MASONRY BREAKPOINTS
   ========================================================= */

/* Large desktop */
@media screen and (min-width: 1400px) {
  ul.product-grid,
  .product-grid {
    columns: 4;
  }
}

/* Desktop / laptop */
@media screen and (min-width: 990px) and (max-width: 1399px) {
  ul.product-grid,
  .product-grid {
    columns: 4;
    column-gap: 14px;
  }

  ul.product-grid > li,
  .product-grid > li,
  .product-grid > .product-grid__item {
    margin-bottom: 14px !important;
  }

  .card-gallery {
    border-radius: 16px;
  }
}

/* Tablet */
@media screen and (min-width: 750px) and (max-width: 989px) {
  ul.product-grid,
  .product-grid {
    columns: 3;
    column-gap: 14px;
  }

  ul.product-grid > li,
  .product-grid > li,
  .product-grid > .product-grid__item {
    margin-bottom: 14px !important;
  }

  .card-gallery {
    border-radius: 14px;
  }

  .cg-hover-top {
    padding: 9px;
  }

  .cg-hover-top__price {
    font-size: 11px;
  }

  .cg-hover-bottom {
    padding: 36px 12px 12px;
  }

  .cg-hover-bottom__title {
    font-size: 13px;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  ul.product-grid,
  .product-grid {
    columns: 2;
    column-gap: 12px;
  }

  ul.product-grid > li,
  .product-grid > li,
  .product-grid > .product-grid__item {
    margin-bottom: 12px !important;
  }

  .card-gallery {
    border-radius: 12px;
  }

  .cg-hover-top {
    padding: 8px;
  }

  .cg-hover-top__price {
    padding: 4px 8px;
    font-size: 10px;
  }

  .cg-hover-bottom {
    padding: 32px 10px 10px;
  }

  .cg-hover-bottom__title {
    margin-bottom: 7px;
    font-size: 12px;
    line-height: 1.35;
  }

  .cg-hover-bottom__btn {
    min-height: 36px;
    padding: 8px 12px;
    font-size: 11px;
  }
}

/* Very narrow phones */
@media screen and (max-width: 359px) {
  ul.product-grid,
  .product-grid {
    columns: 1;
    column-gap: 0;
  }

  ul.product-grid > li,
  .product-grid > li,
  .product-grid > .product-grid__item {
    margin-bottom: 14px !important;
  }

  .card-gallery {
    border-radius: 12px;
  }

  .cg-hover-top {
    padding: 10px;
  }

  .cg-hover-top__price {
    font-size: 12px;
  }

  .cg-hover-bottom {
    padding: 42px 14px 14px;
  }

  .cg-hover-bottom__title {
    font-size: 14px;
  }

  .cg-hover-bottom__btn {
    min-height: 42px;
    padding: 10px 18px;
    font-size: 13px;
  }
}

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  .card-gallery *,
  .card-gallery *::before,
  .card-gallery *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
{% endstylesheet %}